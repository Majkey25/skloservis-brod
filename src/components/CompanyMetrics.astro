---
import { Picture } from 'astro:assets';
import { getAbout, getGallery } from '../content';
import type { Language } from '../lib/urls';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const [about, gallery] = await Promise.all([getAbout(), getGallery()]);
const photo = gallery.find((item) => item.image.src.includes('pergola-glazing')) ?? gallery[0];
const number = new Intl.NumberFormat(lang === 'cs' ? 'cs-CZ' : 'en-GB');
// Decorative line icons in metric order: orders, complete projects, glass tonnage, ground edges.
const icons = [
  [
    'M8.5 3.5h7v3h-7Z',
    'M6.5 5H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-.5',
    'm8.5 13.5 2.5 2.5 4.5-5',
  ],
  ['M5 21V4h14v17', 'M3 21h18', 'M9 8h2', 'M13 8h2', 'M9 12h2', 'M13 12h2', 'M10.5 21v-4.5h3V21'],
  ['m12 4 8 4-8 4-8-4Z', 'm4 12 8 4 8-4', 'm4 16 8 4 8-4'],
  ['M3.5 16 16 3.5l4.5 4.5L8 20.5Z', 'm7 12.5 1.8 1.8', 'm10 9.5 1.8 1.8', 'm13 6.5 1.8 1.8'],
] as const;
const copy = {
  cs: {
    over: 'Přes',
    experience: 'let zkušeností se sklem',
    detail: 'Od prvního návrhu po poslední detail.',
  },
  en: {
    over: 'Over',
    experience: 'years of glassworking experience',
    detail: 'From the first sketch to the finishing touch.',
  },
}[lang];
---

<section class="company-metrics" aria-labelledby="metrics-title">
  {photo && (
    <div class="company-metrics__photo" aria-hidden="true">
      <Picture
        src={photo.image}
        alt=""
        formats={['avif', 'webp']}
        widths={[480, 800, 1200].filter((width) => width <= photo.image.width)}
        sizes="100vw"
        loading="lazy"
        decoding="async"
      />
    </div>
  )}
  <div class="wrap company-metrics__content">
    <div class="company-metrics__heading" data-reveal="rise">
      <p class="company-metrics__experience">
        <span>
          {copy.over} <strong>{number.format(about.experience_years)}</strong>
        </span>
        <span>{copy.experience}</span>
      </p>
      <div>
        <h2 id="metrics-title">{about[`metrics_title_${lang}`]}</h2>
        <p>{copy.detail}</p>
      </div>
    </div>
    <dl class="company-metrics__grid" data-reveal="count">
      {about.metrics.map((metric, index) => (
        <div>
          <dt>{metric[`label_${lang}`]}</dt>
          <dd>
            <svg
              class="company-metrics__icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.3"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
              data-reveal="draw"
            >
              {(icons[index] ?? icons[0]).map((d) => (
                <path d={d} pathLength="1" />
              ))}
            </svg>
            <span class="sr-only">
              {copy.over} {number.format(metric.value)}
            </span>
            <span aria-hidden="true" data-count-number={metric.value}>
              {number.format(metric.value)}
            </span>
            <span class="company-metrics__plus" aria-hidden="true">
              +
            </span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .company-metrics {
    position: relative;
    isolation: isolate;
    padding-block: clamp(3rem, 6vw, 5rem);
    background: #071e28;
    color: #f2f8fb;
  }
  .company-metrics__photo {
    position: absolute;
    z-index: -2;
    inset: 0;
    overflow: hidden;
  }
  .company-metrics__photo :global(picture),
  .company-metrics__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .company-metrics::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: rgb(7 30 40 / 0.88);
    content: '';
  }
  .company-metrics__heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 3rem;
  }
  .company-metrics__heading h2 {
    margin-bottom: 0.75rem;
    font-size: var(--step-2);
  }
  .company-metrics__heading p {
    color: #c5dce5;
  }
  .company-metrics__experience {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .company-metrics__experience > span:last-child {
    max-width: 17ch;
    line-height: 1.4;
  }
  .company-metrics__experience strong {
    margin-left: 0.25rem;
    color: #64d1ec;
    font-size: clamp(3rem, 7vw, 5rem);
    font-weight: 550;
    line-height: 1;
    letter-spacing: -0.06em;
  }
  .company-metrics__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
    margin: 0;
  }
  .company-metrics__grid > div {
    position: relative;
    display: flex;
    flex-direction: column-reverse;
    gap: 0.5rem;
    border-top: 1px solid rgb(197 220 229 / 0.3);
    padding-top: 1.5rem;
  }
  /* A cyan edge runs along the top rule when a figure is pointed at. */
  .company-metrics__grid > div::before {
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: 2px;
    background: #64d1ec;
    content: '';
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 520ms var(--ease);
  }
  .company-metrics__icon {
    display: block;
    grid-column: 1 / -1;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: 0.9rem;
    color: #64d1ec;
    transition: translate 420ms var(--ease);
  }
  .company-metrics__icon path {
    stroke-dasharray: 1;
  }
  @media (hover: hover) and (pointer: fine) {
    .company-metrics__grid > div:hover::before {
      transform: scaleX(1);
    }
    .company-metrics__grid > div:hover .company-metrics__icon {
      translate: 0 -4px;
    }
    .company-metrics__grid > div:hover .company-metrics__icon path {
      animation: metrics-icon-draw 900ms var(--ease) both;
    }
  }
  @keyframes metrics-icon-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  .company-metrics__grid dt {
    color: #c5dce5;
    line-height: 1.4;
  }
  .company-metrics__grid dd {
    display: grid;
    grid-template-columns: max-content max-content;
    align-items: start;
    gap: 0 0.1em;
    margin: 0;
    color: #64d1ec;
    font-size: clamp(2.25rem, 4.5vw, 3.75rem);
    font-weight: 550;
    line-height: 1.1;
    letter-spacing: -0.045em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .company-metrics__plus {
    padding-top: 0.12em;
    font-size: 0.65em;
  }
  @media (max-width: 47.99rem) {
    .company-metrics__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.75rem 1rem;
    }
    .company-metrics__heading {
      margin-bottom: 2rem;
    }
  }
</style>
