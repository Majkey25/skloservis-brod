---
import { getAbout, getContact, getSettings } from '../content';
import { encodeContact } from '../lib/contact';
import { pageUrl, type Language } from '../lib/urls';
import Hours from './Hours.astro';
import Icon from './Icon.astro';
import MapPreview from './MapPreview.astro';
import Reputation from './Reputation.astro';
import ContactLink from './ContactLink.astro';

interface Props {
  lang: Language;
  compact?: boolean;
}

const { lang, compact = false } = Astro.props;
const [contact, settings, about] = await Promise.all([getContact(), getSettings(), getAbout()]);
const copy = {
  cs: {
    call: 'Zavolat',
    email: 'Napsat e-mail',
    copy: 'Kopírovat e-mail',
    copyPhone: 'Kopírovat telefon',
    mailHelp: 'Odkaz otevře vaši e-mailovou aplikaci. Zprávu odešlete až v ní.',
    contactHelp:
      'Na stránce Kontakty nám můžete napsat přímo z formuláře nebo otevřít e-mailovou aplikaci.',
    messageHelp:
      'Pro rychlejší přípravu nabídky a omezení doplňujících dotazů uveďte výrobek a jeho použití, počet kusů, rozměry včetně jednotek, tloušťku, druh a barvu skla, opracování hran, otvory či výřezy a případné kalení. Připište, zda požadujete montáž a kde, nebo osobní odběr. Pokud si některým parametrem nejste jistí, rádi poradíme.',
    messageExample:
      'Dobrý den, prosím o nabídku 1 kusu skla na interiérovou polici: rozměr 200 × 200 mm (20 × 20 cm), tloušťka 6 mm, šedé kouřové, kalené. Všechny hrany broušené a leštěné, rohy zaoblené R5, bez otvorů a výřezů. Bez montáže, osobní odběr v Uherském Brodě. Prosím o cenu a předpokládaný termín zhotovení. Děkuji.\n\nToto je pouze příklad. Napište vlastní zadání.',
    privacy: 'Jak zpracováváme osobní údaje',
    formNote:
      'Formulář předá vaše jméno, e-mail a zprávu službě FormSubmit k přeposlání na náš e-mail. Pole označená * jsou povinná.',
    nameLabel: 'Jméno',
    emailLabel: 'E-mail',
    messageLabel: 'Zpráva',
    required: 'Vyplňte toto pole.',
    invalidEmail: 'Zadejte platnou e-mailovou adresu.',
    tooLong: 'Text je příliš dlouhý.',
    send: 'Odeslat poptávku',
    sending: 'Odesíláme…',
    accepted: 'Děkujeme. Poptávka byla přijata a budeme se jí věnovat v nejbližší pracovní době.',
    failed:
      'Přijetí poptávky se nepodařilo potvrdit, zpráva už ale mohla dorazit. Údaje zůstaly ve formuláři. Než ji odešlete znovu, kontaktujte nás e-mailem nebo telefonicky.',
    workshop: 'Provozovna',
    seat: 'Sídlo a fakturační adresa',
    companyId: 'IČO',
    country: 'Česká republika',
    allContact: 'Všechny kontakty a provozní doba',
  },
  en: {
    call: 'Call us',
    email: 'Write an email',
    copy: 'Copy email address',
    copyPhone: 'Copy phone number',
    mailHelp: 'The link opens your email application. You send the message from there.',
    contactHelp: 'On the Contact page you can use our enquiry form or open your email application.',
    messageHelp:
      'For a faster quotation with fewer follow-up questions, include the product and its use, quantity, dimensions with units, thickness, glass type and colour, edge finish, holes or cut-outs and any tempering. Tell us whether you need installation and where, or workshop collection. We can advise if you are unsure about any specification.',
    messageExample:
      'Hello, please quote for 1 glass pane for an indoor shelf: 200 × 200 mm (20 × 20 cm), 6 mm thick, grey smoked, tempered glass. All edges ground and polished, rounded corners R5, no holes or cut-outs. No installation, collection from your Uherský Brod workshop. Please include the price and estimated completion date. Thank you.\n\nThis is only an example. Write your own requirements.',
    privacy: 'How we process personal data',
    formNote:
      'The form sends your name, email and message to FormSubmit for forwarding to our email address. Fields marked * are required.',
    nameLabel: 'Name',
    emailLabel: 'Email',
    messageLabel: 'Message',
    required: 'Please fill in this field.',
    invalidEmail: 'Enter a valid email address.',
    tooLong: 'This text is too long.',
    send: 'Send enquiry',
    sending: 'Sending…',
    accepted:
      'Thank you. Your enquiry has been received. We will review it during our next working hours.',
    failed:
      'We could not confirm acceptance, but your enquiry may already have arrived. Your details remain in the form. Before sending it again, contact us by email or phone.',
    workshop: 'Workshop',
    seat: 'Registered office and billing address',
    companyId: 'Company ID',
    country: 'Czech Republic',
    allContact: 'All contact details and opening hours',
  },
}[lang];
const titleId = compact ? 'contact-enquiry-title' : 'contact-title';
const Heading = compact ? 'h2' : 'h1';
const profileUrl = about.google_reputation?.url ?? about.reputation?.url ?? contact.map_url;
const limits = { name: 100, email: 254, message: 5000 };
const enquiryTexts = JSON.stringify({
  required: copy.required,
  invalidEmail: copy.invalidEmail,
  tooLong: copy.tooLong,
  sending: copy.sending,
  accepted: copy.accepted,
  failed: copy.failed,
});
---

<section
  class:list={['section', 'contact', { 'contact--compact': compact }]}
  aria-labelledby={titleId}
>
  <div class="wrap">
    <div class="contact__intro">
      <Heading class="section-title" id={titleId}>
        {compact ? contact[`enquiry_title_${lang}`] : contact[`title_${lang}`]}
      </Heading>
      <p class="lead">{compact ? contact[`enquiry_text_${lang}`] : contact[`text_${lang}`]}</p>
    </div>

    <div class="contact__layout">
      <div class="contact__enquiry" data-contact>
        {!compact && (
          <>
            <h2>{contact[`enquiry_title_${lang}`]}</h2>
            <p>{contact[`enquiry_text_${lang}`]}</p>
          </>
        )}
        {/* Copy buttons are laid out from the first paint, so enhancing them never shifts the page. */}
        <noscript>
          <style is:inline>
            .contact__copy,
            .contact__form {
              display: none !important;
            }
          </style>
          <p class="contact__help">
            {lang === 'cs'
              ? 'Pro kontaktní tlačítka a formulář povolte JavaScript.'
              : 'Enable JavaScript to use the contact buttons and enquiry form.'}
          </p>
        </noscript>
        <div class="contact__actions" id="contact-methods">
          {compact ? (
            <a class="button" href={pageUrl('contact', lang, import.meta.env.BASE_URL)}>
              <Icon name="mail" />
              {copy.email}
            </a>
          ) : (
            <ContactLink class="button" value={settings.contact_email} kind="email" lang={lang}>
              <Icon name="mail" />
              {copy.email}
            </ContactLink>
          )}
          <ContactLink
            class="button button--secondary"
            value={contact.phone}
            kind="phone"
            lang={lang}
          >
            <Icon name="phone" />
            {copy.call}
          </ContactLink>
          <ContactLink
            class="text-link contact__copy"
            value={settings.contact_email}
            kind="email"
            lang={lang}
            copy
          >
            <Icon name="copy" />
            {copy.copy}
          </ContactLink>
          <ContactLink
            class="text-link contact__copy"
            value={contact.phone}
            kind="phone"
            lang={lang}
            copy
          >
            <Icon name="copy" />
            {copy.copyPhone}
          </ContactLink>
        </div>
        <p class="contact__help muted">
          {compact ? copy.contactHelp : copy.mailHelp}{' '}
          <a href={profileUrl} rel="noopener noreferrer">
            {lang === 'cs'
              ? 'Veřejný firemní profil a navigace'
              : 'Public business listing and directions'}
          </a>
        </p>
        {compact && (
          <p class="contact__privacy">
            <a class="text-link" href={pageUrl('privacy', lang, import.meta.env.BASE_URL)}>
              {copy.privacy}
            </a>
          </p>
        )}
        <p
          class="contact__status"
          id="contact-copy-status"
          role="status"
          aria-live="polite"
          data-copy-status
        ></p>
        <input
          class="contact__input"
          type="text"
          readonly
          hidden
          data-copy-fallback
          aria-label={
            lang === 'cs'
              ? 'Kontaktní údaj pro ruční kopírování'
              : 'Contact detail for manual copying'
          }
          aria-describedby="contact-copy-status"
        />
        {!compact && (
          <form
            class="contact__form"
            action={pageUrl('contact', lang, import.meta.env.BASE_URL)}
            method="POST"
            inert
            data-astro-reload
            data-enquiry-form
            data-recipient={encodeContact(settings.contact_email)}
            data-texts={enquiryTexts}
          >
            <p class="contact__form-note muted">{copy.formNote}</p>
            <p class="contact__privacy">
              <a class="text-link" href={pageUrl('privacy', lang, import.meta.env.BASE_URL)}>
                {copy.privacy}
              </a>
            </p>
            <div class="contact__field">
              <label for="contact-name">
                {copy.nameLabel}{' '}
                <span class="contact__required" aria-hidden="true">
                  *
                </span>
              </label>
              <input
                class="contact__input"
                id="contact-name"
                name="Jméno"
                type="text"
                autocomplete="name"
                placeholder="Jan Novák"
                maxlength={limits.name}
                required
              />
            </div>
            <div class="contact__field">
              <label for="contact-email">
                {copy.emailLabel}{' '}
                <span class="contact__required" aria-hidden="true">
                  *
                </span>
              </label>
              <input
                class="contact__input"
                id="contact-email"
                name="email"
                type="email"
                autocomplete="email"
                placeholder="example@gmail.com"
                maxlength={limits.email}
                required
              />
            </div>
            <div class="contact__field">
              <label for="contact-message">
                {copy.messageLabel}{' '}
                <span class="contact__required" aria-hidden="true">
                  *
                </span>
              </label>
              <p class="contact__form-note muted" id="contact-message-help">
                {copy.messageHelp}
              </p>
              <textarea
                class="contact__input"
                id="contact-message"
                name="Zpráva"
                rows="10"
                placeholder={copy.messageExample}
                aria-describedby="contact-message-help"
                maxlength={limits.message}
                required
              ></textarea>
            </div>
            <input
              class="contact__trap"
              type="text"
              name="_honey"
              tabindex="-1"
              autocomplete="off"
              aria-hidden="true"
            />
            <input type="hidden" name="_subject" value="SKLOSERVIS-BROD: Nezávazná poptávka" />
            <input type="hidden" name="_template" value="basic" />
            <input type="hidden" name="_captcha" value="false" />
            <input type="hidden" name="name" data-draft-for="contact-name" disabled />
            <input type="hidden" name="message" data-draft-for="contact-message" disabled />
            <div class="contact__actions">
              <button class="button" type="submit">
                <Icon name="send" />
                <span data-send-label>{copy.send}</span>
              </button>
            </div>
            <p class="contact__status" role="status" aria-live="polite" data-enquiry-status></p>
          </form>
        )}
        {compact && (
          <a class="text-link" href={pageUrl('contact', lang, import.meta.env.BASE_URL)}>
            {copy.allContact} <Icon name="arrow-right" />
          </a>
        )}
      </div>

      {!compact && (
        <div class="contact__business">
          <h2>{settings.name}</h2>
          <p>
            {copy.companyId}: {contact.company_id}
          </p>
          <dl class="contact__addresses">
            <div>
              <dt>
                <Icon name="location" reveal /> {copy.workshop}
              </dt>
              <dd>
                <address>
                  {contact.address.street}
                  <br />
                  {contact.address.postal_code} {contact.address.city}
                  <br />
                  {copy.country}
                </address>
              </dd>
            </div>
            <div>
              <dt>{copy.seat}</dt>
              <dd>
                <address>
                  {contact.billing_address.street}
                  <br />
                  {contact.billing_address.postal_code} {contact.billing_address.city}
                  <br />
                  {copy.country}
                </address>
              </dd>
            </div>
          </dl>
          <Hours lang={lang} />
        </div>
      )}
    </div>
    <MapPreview lang={lang} />
  </div>
</section>
{!compact && <Reputation lang={lang} />}

<script>
  import { sendEnquiry } from '../lib/enquiry';
  import { decodeContact } from '../lib/contact';

  type FieldControl = HTMLInputElement | HTMLTextAreaElement;

  interface EnquiryTexts {
    required: string;
    invalidEmail: string;
    tooLong: string;
    sending: string;
    accepted: string;
    failed: string;
  }

  const boundForms = new WeakSet<HTMLFormElement>();
  const activeRequests = new Map<HTMLFormElement, AbortController>();

  function initializeEnquiryForm() {
    document.querySelectorAll<HTMLFormElement>('[data-enquiry-form]').forEach((form) => {
      if (boundForms.has(form)) return;
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const label = button?.querySelector<HTMLElement>('[data-send-label]');
      const status = form.querySelector<HTMLElement>('[data-enquiry-status]');
      if (!form.dataset.recipient || !button || !label || !status) return;
      boundForms.add(form);
      // Older open tabs copy drafts by the previous field names before this script loads.
      form.querySelectorAll<HTMLInputElement>('[data-draft-for]').forEach((alias) => {
        const field = form.querySelector<FieldControl>(`#${alias.dataset.draftFor}`);
        if (field && !field.value) field.value = alias.value;
        alias.remove();
      });
      form.noValidate = true;
      const texts = JSON.parse(form.dataset.texts || '{}') as EnquiryTexts;
      const controls = Array.from(form.querySelectorAll<FieldControl>('[required]'));
      const valueOf = (name: string) =>
        form.querySelector<FieldControl>(`[name="${name}"]`)?.value.trim() ?? '';

      const messageFor = (control: FieldControl) => {
        if (control.required && !control.value.trim()) return texts.required;
        if (control.validity.typeMismatch) return texts.invalidEmail;
        if (control.maxLength > 0 && control.value.length > control.maxLength) return texts.tooLong;
        return '';
      };
      const validate = (control: FieldControl) => control.setCustomValidity(messageFor(control));
      controls.forEach((control) =>
        control.addEventListener('input', () => {
          validate(control);
          status.textContent = '';
        }),
      );
      // Own submission before older page-load handlers bind an obsolete payload.
      form.addEventListener(
        'submit',
        async (event) => {
          if (event.defaultPrevented) return;
          event.preventDefault();
          event.stopImmediatePropagation();
          if (!form.isConnected || activeRequests.has(form)) return;
          controls.forEach(validate);
          if (!form.reportValidity()) return;
          if (valueOf('_honey')) {
            status.textContent = texts.failed;
            return;
          }
          const controller = new AbortController();
          activeRequests.set(form, controller);
          const originalLabel = label.textContent;
          button.disabled = true;
          label.textContent = texts.sending;
          controls.forEach((control) => (control.readOnly = true));
          form.setAttribute('aria-busy', 'true');
          status.textContent = texts.sending;
          try {
            await sendEnquiry(
              `https://formsubmit.co/ajax/${decodeContact(form.dataset.recipient ?? '', 'email')}`,
              {
                Jméno: valueOf('Jméno'),
                email: valueOf('email'),
                Zpráva: valueOf('Zpráva'),
                _honey: '',
                _subject: valueOf('_subject'),
                _template: 'basic',
                _captcha: 'false',
              },
              controller.signal,
            );
            if (!form.isConnected) return;
            form.reset();
            status.textContent = texts.accepted;
          } catch {
            if (form.isConnected) status.textContent = texts.failed;
          } finally {
            activeRequests.delete(form);
            button.disabled = false;
            label.textContent = originalLabel;
            controls.forEach((control) => (control.readOnly = false));
            form.removeAttribute('aria-busy');
          }
        },
        true,
      );
      form.inert = false;
    });
  }

  initializeEnquiryForm();
  document.addEventListener('astro:after-swap', initializeEnquiryForm);
  document.addEventListener('astro:before-swap', (event) => {
    const current = document.querySelector<HTMLFormElement>('[data-enquiry-form]');
    const incoming = event.newDocument.querySelector<HTMLFormElement>('[data-enquiry-form]');
    if (
      current &&
      incoming &&
      document.documentElement.lang !== event.newDocument.documentElement.lang
    ) {
      // Keep a language change from discarding an enquiry; never persist or resubmit it.
      for (const id of ['contact-name', 'contact-email', 'contact-message']) {
        const source = current.querySelector<FieldControl>(`#${id}`);
        const target = incoming.querySelector<FieldControl>(`#${id}`);
        if (source && target) target.value = source.value;
      }
      if (current.getAttribute('aria-busy') === 'true') {
        const status = incoming.querySelector<HTMLElement>('[data-enquiry-status]');
        const texts = JSON.parse(incoming.dataset.texts || '{}') as EnquiryTexts;
        if (status) status.textContent = texts.failed;
      }
    }
    activeRequests.forEach((controller) => controller.abort());
    activeRequests.clear();
  });
</script>

<style>
  .contact__intro {
    max-width: 48rem;
    margin-bottom: 2.5rem;
  }

  .contact__layout {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .contact--compact .contact__layout {
    grid-template-columns: minmax(0, 1fr);
  }

  .contact__enquiry {
    padding: clamp(1.5rem, 3.5vw, 3rem);
    background: var(--surface);
    border-radius: var(--radius, 6px);
  }

  .contact__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
  }

  .contact__copy {
    min-height: 2.75rem;
    padding: 0.5rem 0;
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
  }

  .contact__copy {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .contact__help,
  .contact__privacy,
  .contact__status,
  .contact__form-note {
    font-size: 0.9375rem;
  }

  .contact__status:empty {
    margin: 0;
  }

  .contact__status {
    overflow-wrap: anywhere;
    user-select: all;
  }

  .contact__form {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .contact__trap {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .contact__form button:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .contact__form-note {
    margin-bottom: 1.5rem;
  }

  .contact__field {
    display: grid;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }

  .contact__field label {
    font-weight: 600;
  }

  .contact__input {
    width: 100%;
    min-height: 48px;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--muted);
    border-radius: var(--radius, 6px);
    background: var(--bg);
    color: var(--text);
    font: inherit;
  }

  textarea.contact__input {
    min-height: 9rem;
    resize: vertical;
  }

  .contact__input::placeholder {
    color: var(--muted);
    opacity: 1;
  }

  .contact__business {
    border-inline-start: 1px solid var(--line, currentColor);
    padding-inline-start: clamp(1.5rem, 4vw, 3rem);
  }

  .contact__business > h2 {
    font-size: var(--step-2);
    line-height: 1.25;
  }

  .contact__addresses {
    display: grid;
    gap: 1.5rem;
    margin-block: 1.5rem 2rem;
  }

  .contact__addresses dt {
    font-weight: 650;
    margin-bottom: 0.375rem;
  }

  .contact__addresses dd {
    margin: 0;
  }

  .contact__addresses address {
    font-style: normal;
    line-height: 1.65;
  }

  @media (max-width: 48rem) {
    .contact__layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .contact__enquiry {
      padding: 1.5rem;
    }

    .contact__business {
      border-inline-start: 0;
      border-top: 1px solid var(--line, currentColor);
      padding-inline-start: 0;
      padding-top: 2rem;
    }
  }
</style>
