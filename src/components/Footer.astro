---
import { Image } from 'astro:assets';
import logo from '../assets/brand/wordpress-logo.png';
import { getSettings, getContact } from '../content.ts';
import { pageUrl, type Language } from '../lib/urls.ts';
import Icon from './Icon.astro';
import ContactLink from './ContactLink.astro';
interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const settings = await getSettings();
const contact = await getContact();
const base = import.meta.env.BASE_URL;
---

<footer class="site-footer">
  <div class="wrap footer-main">
    <div>
      <a class="footer-brand" href={pageUrl('home', lang, base)}>
        <Image src={logo} alt="" width={80} height={80} class="footer-logo" />
        <span>Skloservis Brod</span>
      </a>
      <p>{lang === 'cs' ? settings.footer_text_cs : settings.footer_text_en}</p>
    </div>
    <div class="footer-contact">
      <ContactLink value={contact.phone} kind="phone" lang={lang}>
        <Icon name="phone" /> {lang === 'cs' ? 'Zavolat' : 'Call us'}
      </ContactLink>
      <ContactLink value={settings.contact_email} kind="email" lang={lang}>
        <Icon name="mail" /> {lang === 'cs' ? 'Napsat e-mail' : 'Write an email'}
      </ContactLink>
      {contact.facebook_url && (
        <a href={contact.facebook_url} target="_blank" rel="noopener noreferrer">
          <Icon name="facebook" /> Facebook
        </a>
      )}
    </div>
    <address class="footer-address">
      <Icon name="location" />
      {lang === 'cs' ? 'Provozovna' : 'Workshop'}
      <br />
      {contact.address.street}
      <br />
      {contact.address.postal_code} {contact.address.city}
    </address>
  </div>
  <div class="wrap footer-bottom">
    <div class="footer-legal">
      <p>
        {settings.name} · IČO {contact.company_id}
      </p>
      <button type="button" class="footer-theme-system" data-theme-system hidden>
        {lang === 'cs' ? 'Použít nastavení zařízení' : 'Use device theme'}
      </button>
    </div>
    <p class="footer-credit">
      made by{' '}
      <a class="footer-credit__name" href="https://majkey25.github.io/init/" data-scramble>
        <span class="footer-credit__text">Majkey25</span>
        <span class="footer-credit__code" aria-hidden="true"></span>
      </a>
    </p>
    <nav aria-label={lang === 'cs' ? 'Právní informace' : 'Legal information'}>
      <a href={pageUrl('privacy', lang, base)}>{lang === 'cs' ? 'Soukromí' : 'Privacy'}</a>
      <a href={pageUrl('cookies', lang, base)}>
        {lang === 'cs' ? 'Cookies a úložiště' : 'Cookies and storage'}
      </a>
      <a href={pageUrl('legal', lang, base)}>
        {lang === 'cs' ? 'Právní informace' : 'Legal information'}
      </a>
    </nav>
  </div>
</footer>
<script>
  // Pointing at or focusing the author name decodes it like a hash. Each real letter gets a cell
  // of its exact width that cycles through code glyphs until a scan line passes and locks it.
  // A skew and shake decay to nothing, so the final frame matches the label exactly. The real
  // name stays in the link, so its accessible text, width and hit area never change.
  const glyphs = '0123456789abcdef#$%&*+=?<>/|{}[]~^_:;';
  const duration = 1200;
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
  const running = new Map<HTMLElement, number>();

  function stop(link: HTMLElement) {
    cancelAnimationFrame(running.get(link) ?? 0);
    running.delete(link);
    link.removeAttribute('data-scrambling');
    const code = link.querySelector<HTMLElement>('.footer-credit__code');
    code?.replaceChildren();
    code?.removeAttribute('style');
  }

  function scramble(link: HTMLElement) {
    const label = link.querySelector('.footer-credit__text')?.firstChild;
    const code = link.querySelector<HTMLElement>('.footer-credit__code');
    if (calm.matches || running.has(link) || !(label instanceof Text) || !code) return;
    const range = document.createRange();
    let width = 0;
    const cells = Array.from(label.data, (letter, index) => {
      range.setStart(label, index);
      range.setEnd(label, index + 1);
      const cell = document.createElement('span');
      const size = range.getBoundingClientRect().width;
      cell.style.width = `${size}px`;
      code.append(cell);
      // Each letter locks just after the scan line passes its centre.
      const at = width + size * (0.5 + Math.random() * 0.4);
      width += size;
      return { cell, letter, at };
    });
    link.setAttribute('data-scrambling', '');
    const started = performance.now();
    let drawn = 0;
    const tick = (now: number) => {
      const progress = Math.min((now - started) / duration, 1);
      // The scan crosses the name in 12–60% of the run, so the last lock flash ends in time.
      const scan = Math.min(Math.max((progress - 0.12) / 0.48, 0), 1) * width;
      // About 30 glyph changes a second keeps the noise readable as code, not as flicker.
      if (now - drawn > 32 || progress === 1) {
        drawn = now;
        for (const item of cells) {
          if (item.cell.hasAttribute('data-locked')) continue;
          if (scan >= item.at) {
            item.cell.setAttribute('data-locked', '');
            item.cell.textContent = item.letter;
          } else item.cell.textContent = glyphs[Math.floor(Math.random() * glyphs.length)];
        }
      }
      const decay = (1 - progress) ** 2;
      const shake = (1.5 * Math.sin(now / 23) * decay).toFixed(2);
      const skew = (9 * Math.sin(now / 41) * decay).toFixed(2);
      code.style.transform = `translateX(${shake}px) skewX(${skew}deg)`;
      code.style.setProperty('--scan', `${scan.toFixed(1)}px`);
      code.style.setProperty('--fade', (1 - progress ** 4).toFixed(3));
      if (progress < 1) running.set(link, requestAnimationFrame(tick));
      else stop(link);
    };
    running.set(link, requestAnimationFrame(tick));
  }

  const target = (event: Event) =>
    event.target instanceof Element ? event.target.closest<HTMLElement>('[data-scramble]') : null;
  document.addEventListener('pointerover', (event) => {
    const link = target(event);
    if (link && !link.contains(event.relatedTarget as Node | null)) scramble(link);
  });
  document.addEventListener('focusin', (event) => {
    const link = target(event);
    if (link) scramble(link);
  });
  const stopAll = () => running.forEach((_, link) => stop(link));
  document.addEventListener('astro:before-swap', stopAll);
  window.addEventListener('pagehide', stopAll);
  calm.addEventListener('change', () => {
    if (calm.matches) stopAll();
  });
</script>
<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-top: 3rem;
  }
  .footer-main {
    display: grid;
    gap: 2rem;
    padding-bottom: 3rem;
  }
  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    font-size: 1.4rem;
    text-decoration: none;
    letter-spacing: -0.03em;
  }
  .footer-logo {
    width: 40px;
    height: 40px;
    flex: none;
  }
  .footer-main p,
  .footer-address {
    max-width: 45ch;
    margin-top: 0.6rem;
    color: var(--muted);
    font-size: var(--step--1);
    font-style: normal;
  }
  .footer-contact {
    display: grid;
    align-content: start;
    gap: 0.4rem;
  }
  .footer-contact a {
    color: var(--accent);
    overflow-wrap: anywhere;
  }
  /* Narrow screens stack the bar as one centred column. Wide screens put the credit in an auto
     column between two equal side columns, so it sits at the bar's true centre whatever the
     side groups measure. The 1rem row gap exceeds the credit link's 0.75rem target overhang,
     so a neighbouring row never shares hit area with it. */
  .footer-bottom {
    border-top: 1px solid var(--line);
    padding-block: 1.5rem;
    display: grid;
    justify-items: center;
    gap: 1rem 2rem;
    font-size: var(--step--1);
    color: var(--muted);
    text-align: center;
  }
  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0 1rem;
  }
  .footer-legal p {
    max-width: none;
  }
  .footer-theme-system {
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--accent);
    font-size: var(--step--1);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .footer-bottom nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem 1.5rem;
  }
  .footer-bottom a {
    text-decoration: none;
  }
  .footer-bottom a:hover {
    text-decoration: underline;
  }
  .footer-credit__name {
    position: relative;
    display: inline-block;
    /* A 44px tall target that adds no height to the compact bar. */
    margin-block: -0.75rem;
    padding-block: 0.75rem;
    color: var(--accent);
    font-weight: 650;
  }
  .footer-credit__name:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  /* The overlay sits exactly over the real name, so decoding never changes layout or width. */
  .footer-credit__code {
    position: absolute;
    top: 0.75rem;
    left: 0;
    white-space: nowrap;
    pointer-events: none;
  }
  .footer-credit__code > :global(span) {
    display: inline-block;
    text-align: center;
  }
  .footer-credit__code > :global(span:not([data-locked])) {
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
    text-shadow:
      1.5px 0 color-mix(in srgb, var(--accent) 55%, transparent),
      -1.5px 0 color-mix(in srgb, var(--text) 35%, transparent);
  }
  .footer-credit__code > :global(span[data-locked]) {
    animation: footer-credit-lock 380ms var(--ease) both;
  }
  /* The scan line that locks each letter as it passes, fading out at the end. */
  .footer-credit__code::after {
    position: absolute;
    top: 0.15em;
    bottom: 0.15em;
    left: -1px;
    width: 2px;
    border-radius: 1px;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    content: '';
    opacity: var(--fade, 0);
    translate: var(--scan, 0) 0;
  }
  .footer-credit__name[data-scrambling] .footer-credit__text {
    color: transparent;
  }
  @keyframes footer-credit-lock {
    from {
      color: var(--text);
      text-shadow: 0 0 10px var(--accent);
    }
  }
  @media (min-width: 48rem) {
    .footer-main {
      grid-template-columns: 1.4fr 1fr 1fr;
    }
  }
  @media (min-width: 64rem) {
    .footer-bottom {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: center;
      text-align: start;
    }
    .footer-legal {
      justify-self: start;
      justify-content: flex-start;
    }
    .footer-bottom nav {
      justify-self: end;
      justify-content: flex-end;
    }
  }
</style>
