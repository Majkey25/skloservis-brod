---
import { getSettings, getContact } from '../content.ts';
import { pageUrl, type Language } from '../lib/urls.ts';
interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const settings = await getSettings();
const contact = await getContact();
const base = import.meta.env.BASE_URL;
---

<footer class="site-footer">
  <div class="wrap footer-main">
    <div>
      <a class="footer-brand" href={pageUrl('home', lang, base)}>
        Skloservis Brod
      </a>
      <p>{lang === 'cs' ? settings.footer_text_cs : settings.footer_text_en}</p>
    </div>
    <div class="footer-contact">
      <a href={`tel:${contact.phone}`}>+420 608 031 206</a>
      <a href={`mailto:${settings.contact_email}`}>{settings.contact_email}</a>
    </div>
  </div>
  <div class="wrap footer-bottom">
    <p>
      {settings.name} · IČO {contact.company_id}
    </p>
    <nav aria-label={lang === 'cs' ? 'Právní informace' : 'Legal information'}>
      <a href={pageUrl('privacy', lang, base)}>{lang === 'cs' ? 'Soukromí' : 'Privacy'}</a>
      <a href={pageUrl('cookies', lang, base)}>
        {lang === 'cs' ? 'Cookies a úložiště' : 'Cookies and storage'}
      </a>
      <a href={pageUrl('legal', lang, base)}>
        {lang === 'cs' ? 'Právní informace' : 'Legal information'}
      </a>
    </nav>
  </div>
</footer>
<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-top: 3rem;
  }
  .footer-main {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 3rem;
  }
  .footer-brand {
    font-weight: 700;
    font-size: 1.4rem;
    text-decoration: none;
    letter-spacing: -0.03em;
  }
  .footer-main p {
    max-width: 45ch;
    margin-top: 0.6rem;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .footer-contact {
    display: grid;
    align-content: start;
    gap: 0.4rem;
  }
  .footer-contact a {
    color: var(--accent);
  }
  .footer-bottom {
    border-top: 1px solid var(--line);
    padding-block: 1.5rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .footer-bottom nav {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .footer-bottom a {
    text-decoration: none;
  }
  .footer-bottom a:hover {
    text-decoration: underline;
  }
  @media (max-width: 760px) {
    .footer-main,
    .footer-bottom {
      flex-direction: column;
    }
    .footer-contact {
      gap: 0.7rem;
    }
    .footer-bottom nav {
      gap: 1rem;
    }
  }
</style>
