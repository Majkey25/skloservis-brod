---
import { getImage, Picture } from 'astro:assets';
import { getGallery, getServices, getSettings } from '../content.ts';
import {
  GALLERY_ONLY_CATEGORIES,
  isServiceCategory,
  type GalleryCategory,
} from '../lib/gallery.ts';
import { pageUrl, type Language, type ServiceSlug } from '../lib/urls.ts';
import Icon from './Icon.astro';

interface Props {
  lang: Language;
  compact?: boolean;
  category?: GalleryCategory;
  heading?: string;
  /** The first photo is already rendered as this anchor, outside the thumbnail grid. */
  heroId?: string;
}

const { lang, compact = false, category, heading, heroId } = Astro.props;
const filterable = !compact && !category;
// Request-local numbering avoids collisions when a page contains several galleries.
const locals = Astro.locals as { galleryCount?: number };
const instance = filterable ? (locals.galleryCount = (locals.galleryCount ?? 0) + 1) : 0;
const galleryKey = instance === 1 ? 'gallery' : `gallery-${instance}`;

const [settings, services, gallery] = await Promise.all([
  getSettings(),
  getServices(),
  getGallery(),
]);

const base = import.meta.env.BASE_URL;

const labels = {
  cs: {
    heading: settings.gallery_title_cs,
    lead: settings.gallery_text_cs,
    viewAll: 'Prohlédnout celou galerii',
    close: 'Zavřít prohlížeč',
    prev: 'Předchozí fotografie',
    next: 'Další fotografie',
    dialogLabel: 'Fotogalerie realizací',
    loading: 'Načítání fotografie…',
    error: 'Fotografii se nepodařilo načíst.',
    openDirectly: 'Otevřít původní soubor',
    filter: 'Kategorie fotografií',
    all: 'Všechny fotografie',
    empty: 'V této kategorii zatím nejsou fotografie.',
  },
  en: {
    heading: settings.gallery_title_en,
    lead: settings.gallery_text_en,
    viewAll: 'View complete gallery',
    close: 'Close gallery viewer',
    prev: 'Previous photo',
    next: 'Next photo',
    dialogLabel: 'Project photo gallery',
    loading: 'Loading photo…',
    error: 'Failed to load photo.',
    openDirectly: 'Open original file',
    filter: 'Photo categories',
    all: 'All photos',
    empty: 'There are no photos in this category yet.',
  },
}[lang];

const serviceMap = new Map<ServiceSlug, string>(
  services.map((service) => [service.slug, service[`title_${lang}`]]),
);

const categoryName = (value: GalleryCategory) =>
  isServiceCategory(value)
    ? (serviceMap.get(value) ?? value)
    : GALLERY_ONLY_CATEGORIES[value][lang];
const scopedItems = category ? gallery.filter((item) => item.category === category) : gallery;
const displayItems = compact
  ? scopedItems
      .filter(
        (item, index) =>
          scopedItems.findIndex((photo) => photo.category === item.category) === index,
      )
      // Keep project examples distinct from the first photo used on product cards.
      .map((item) => scopedItems.filter((photo) => photo.category === item.category)[1] ?? item)
      .slice(0, 6)
  : scopedItems;

const categories = [...new Set(displayItems.map((item) => item.category))].map((value) => ({
  value,
  label: categoryName(value),
  count: displayItems.filter((item) => item.category === value).length,
}));
// CSS applies bookmarked filters before JS/native lazy loading, including without JS.
// All pictures remain ordinary static HTML, in their original content order.
const filterStyles = filterable
  ? categories
      .map(
        ({ value }) =>
          `[data-gallery-key="${galleryKey}"]:has([data-gallery-filter="${value}"]:target) .gallery-item:not([data-category="${value}"]) { display: none; }`,
      )
      .join('\n')
  : '';

const itemsData = await Promise.all(
  displayItems.map(async (item, index) => {
    const width = Math.max(
      1,
      Math.floor(
        item.image.width * Math.min(1, 1600 / Math.max(item.image.width, item.image.height)),
      ),
    );
    const viewer = await getImage({
      src: item.image,
      width,
      widths: [...new Set([480, 800, 1200, width].filter((size) => size <= width))],
      format: 'webp',
    });
    return {
      index,
      src: viewer.src,
      srcset: viewer.srcSet.attribute,
      width: Number(viewer.attributes.width),
      height: Number(viewer.attributes.height),
      original: item.image.src,
      alt: item[`alt_${lang}`],
      caption: item[`caption_${lang}`] ?? '',
      category: categoryName(item.category),
      categoryKey: item.category,
    };
  }),
);

const safeJsonData = JSON.stringify(itemsData).replace(/</g, '\\u003c');
---

<section
  id={heroId ? `${heroId}-gallery` : undefined}
  class="section gallery-section"
  aria-label={heading ?? (category ? categoryName(category) : labels.heading)}
  data-gallery-root
  data-gallery-key={filterable ? galleryKey : undefined}
  data-gallery-hero={heroId}
>
  {filterStyles && <style is:inline set:html={filterStyles} />}
  <div class="wrap">
    {(compact || heading) && (
      <div class="gallery-header" data-reveal="rise">
        <h2 class="section-title">{heading ?? labels.heading}</h2>
        {compact && <p class="muted">{labels.lead}</p>}
        {category && (
          <a class="text-link" href={pageUrl('gallery', lang, base)}>
            {labels.viewAll}
          </a>
        )}
      </div>
    )}

    {filterable && displayItems.length > 0 && (
      <nav class="gallery-filters" aria-label={labels.filter}>
        <a id={`${galleryKey}-all`} href={`#${galleryKey}-all`} data-gallery-filter="all">
          <span data-filter-label>{labels.all}</span> <span>({displayItems.length})</span>
        </a>
        {categories.map(({ value, label, count }) => (
          <a
            id={`${galleryKey}-${value}`}
            href={`#${galleryKey}-${value}`}
            data-gallery-filter={value}
          >
            <span data-filter-label>{label}</span> <span>({count})</span>
          </a>
        ))}
      </nav>
    )}
    <p
      class="gallery-status muted"
      data-gallery-status
      role="status"
      aria-atomic="true"
      hidden={compact}
    >
      {!filterable && `${category ? categoryName(category) : labels.all} — ${displayItems.length}`}
    </p>
    {displayItems.length === 0 && <p>{labels.empty}</p>}

    <div class:list={['gallery-grid', compact && 'gallery-grid--compact']} role="list">
      {displayItems.map((item, index) => {
        if (heroId && index === 0) return null;
        const name = categoryName(item.category);
        const caption = item[`caption_${lang}`];
        const altText = item[`alt_${lang}`];
        const sizes = compact
          ? '(min-width: 64rem) 25rem, 47vw'
          : '(min-width: 64rem) 25rem, (min-width: 40rem) 47vw, 100vw';

        return (
          <div
            class="gallery-item"
            role="listitem"
            data-category={item.category}
            data-reveal="rise"
          >
            <figure class="gallery-card__figure">
              <a
                href={item.image.src}
                class="gallery-card"
                data-gallery-card
                data-index={index}
                aria-haspopup="dialog"
                aria-label={`${altText} — ${name}`}
                data-astro-reload
              >
                <div class="gallery-card__image-wrap">
                  <Picture
                    src={item.image}
                    alt={altText}
                    formats={['avif', 'webp']}
                    width={Math.min(960, item.image.width)}
                    widths={[
                      ...new Set(
                        [360, 540, 720, Math.min(960, item.image.width)].filter(
                          (width) => width <= item.image.width,
                        ),
                      ),
                    ]}
                    sizes={sizes}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </a>
              <figcaption class="gallery-card__caption">
                {isServiceCategory(item.category) ? (
                  <a class="gallery-card__category" href={pageUrl(item.category, lang, base)}>
                    {name}
                  </a>
                ) : (
                  <span class="gallery-card__category">{name}</span>
                )}
                {caption && <span class="gallery-card__text">{caption}</span>}
              </figcaption>
            </figure>
          </div>
        );
      })}
    </div>

    {compact && (
      <div class="gallery-action">
        <a class="button button--secondary" href={pageUrl('gallery', lang, base)}>
          {labels.viewAll}
        </a>
      </div>
    )}

    <dialog class="gallery-dialog" data-dialog aria-label={labels.dialogLabel}>
      <div class="gallery-dialog__container">
        <header class="gallery-dialog__header">
          <span class="gallery-dialog__counter" data-counter aria-live="polite"></span>
          <button type="button" class="gallery-dialog__close" data-close aria-label={labels.close}>
            <Icon name="close" />
          </button>
        </header>

        <div class="gallery-dialog__body">
          <button
            type="button"
            class="gallery-dialog__nav gallery-dialog__nav--prev"
            data-prev
            aria-label={labels.prev}
          >
            <Icon name="arrow-left" />
          </button>

          <div class="gallery-dialog__viewport" data-viewport>
            <div class="gallery-dialog__loader" data-loader aria-hidden="true">
              <span class="sr-only">{labels.loading}</span>
            </div>
            <img class="gallery-dialog__image" data-dialog-image alt="" decoding="async" hidden />
            <div class="gallery-dialog__error" data-dialog-error role="status" hidden>
              <p>{labels.error}</p>
              <a
                class="button button--secondary"
                data-fallback-link
                href={displayItems[0]?.image.src ?? pageUrl('gallery', lang, base)}
                target="_blank"
                rel="noopener noreferrer"
              >
                {labels.openDirectly}
              </a>
            </div>
          </div>

          <button
            type="button"
            class="gallery-dialog__nav gallery-dialog__nav--next"
            data-next
            aria-label={labels.next}
          >
            <Icon name="arrow-right" />
          </button>
        </div>

        <footer class="gallery-dialog__footer">
          <p class="gallery-dialog__category" data-dialog-category></p>
          <p class="gallery-dialog__caption" data-dialog-caption></p>
        </footer>
      </div>
    </dialog>

    <script type="application/json" data-gallery-data set:html={safeJsonData} />
  </div>
</section>

<script>
  import { navigate } from 'astro:transitions/client';

  // Viewer flight timing in ms. A late image load skips the flight from its card.
  const FLIGHT_OPEN_MS = 420;
  const FLIGHT_CLOSE_MS = 320;
  const FLIGHT_LOAD_WINDOW_MS = 350;
  const FLIGHT_EASING = 'cubic-bezier(0.2, 0.7, 0.2, 1)';
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  // Each open viewer registers its stop function; client navigation and page hide run them all.
  const stops = new Set<() => void>();
  const disposals = new Set<() => void>();
  const filters = new Set<() => void>();
  const stopAll = () => stops.forEach((stop) => stop());
  document.addEventListener('astro:before-swap', () => {
    disposals.forEach((dispose) => dispose());
    disposals.clear();
    stops.clear();
    filters.clear();
  });
  window.addEventListener('pagehide', stopAll);
  window.addEventListener('hashchange', () => filters.forEach((sync) => sync()));
  window.addEventListener('popstate', () => filters.forEach((sync) => sync()));
  window.addEventListener('pageshow', () => filters.forEach((sync) => sync()));
  reducedMotion.addEventListener('change', () => {
    if (reducedMotion.matches) stopAll();
  });

  function initGalleries() {
    const roots = document.querySelectorAll<HTMLElement>('[data-gallery-root]');

    roots.forEach((root) => {
      if (root.dataset.initialized === 'true') return;
      root.dataset.initialized = 'true';

      const dataScript = root.querySelector<HTMLScriptElement>('[data-gallery-data]');
      if (!dataScript) return;

      interface GalleryItemData {
        index: number;
        src: string;
        srcset: string;
        width: number;
        height: number;
        original: string;
        alt: string;
        caption: string;
        category: string;
        categoryKey: string;
      }

      let items: GalleryItemData[] = [];
      try {
        items = JSON.parse(dataScript.textContent || '[]');
      } catch {
        return;
      }
      if (items.length === 0) return;

      const modalDialog = root.querySelector<HTMLDialogElement>('[data-dialog]');
      const modalImage = root.querySelector<HTMLImageElement>('[data-dialog-image]');
      if (!modalDialog || !modalImage) return;

      const activeDialog: HTMLDialogElement = modalDialog;
      const activeImage: HTMLImageElement = modalImage;

      const closeBtn = root.querySelector<HTMLButtonElement>('[data-close]');
      const prevBtn = root.querySelector<HTMLButtonElement>('[data-prev]');
      const nextBtn = root.querySelector<HTMLButtonElement>('[data-next]');
      const counter = root.querySelector<HTMLElement>('[data-counter]');
      const viewport = root.querySelector<HTMLElement>('[data-viewport]');
      const errorBox = root.querySelector<HTMLElement>('[data-dialog-error]');
      const fallbackLink = root.querySelector<HTMLAnchorElement>('[data-fallback-link]');
      const categoryEl = root.querySelector<HTMLElement>('[data-dialog-category]');
      const captionEl = root.querySelector<HTMLElement>('[data-dialog-caption]');
      const hero = document.getElementById(root.dataset.galleryHero ?? '');
      const cards = [
        ...(hero instanceof HTMLAnchorElement ? [hero] : []),
        ...root.querySelectorAll<HTMLAnchorElement>('[data-gallery-card]'),
      ];
      const rows = root.querySelectorAll<HTMLElement>('.gallery-item');
      const filterLinks = Array.from(
        root.querySelectorAll<HTMLAnchorElement>('[data-gallery-filter]'),
      );
      const status = root.querySelector<HTMLElement>('[data-gallery-status]');
      const controller = new AbortController();
      const listenerOptions = { signal: controller.signal };

      let visibleItems = items;
      let selectedCategory = '';
      let activeIndex = 0;
      let requestId = 0;
      let triggerElement: HTMLElement | null = null;
      let flip: { card: HTMLElement; openedAt: number } | null = null;
      let flight: Animation | null = null;
      let closing = false;
      let pendingImage: HTMLImageElement | null = null;

      const cancelLoad = () => {
        requestId++;
        if (!pendingImage) return;
        pendingImage.onload = null;
        pendingImage.onerror = null;
        pendingImage.removeAttribute('srcset');
        pendingImage.removeAttribute('src');
        pendingImage = null;
      };

      const activeCard = () =>
        cards.find((card) => Number(card.dataset.index) === visibleItems[activeIndex]?.index);

      const renderSlide = (index: number) => {
        if (closing || !visibleItems.length) return;
        stopFlight();
        cancelLoad();
        flip = null;
        activeIndex = (index + visibleItems.length) % visibleItems.length;
        const currentReq = ++requestId;
        const item = visibleItems[activeIndex];
        if (!item) return;

        if (counter) counter.textContent = `${activeIndex + 1} / ${visibleItems.length}`;
        if (prevBtn) prevBtn.disabled = visibleItems.length < 2;
        if (nextBtn) nextBtn.disabled = visibleItems.length < 2;
        if (categoryEl) categoryEl.textContent = item.category || '';
        if (captionEl) captionEl.textContent = item.caption || item.alt || '';
        if (fallbackLink) fallbackLink.href = item.original;

        viewport?.classList.add('is-loading');
        viewport?.setAttribute('aria-busy', 'true');
        if (errorBox) errorBox.hidden = true;

        // Clear previous image during loading to avoid showing old image with new alt/caption
        activeImage.hidden = true;
        activeImage.removeAttribute('srcset');
        activeImage.removeAttribute('src');
        activeImage.alt = item.alt;
        activeImage.width = item.width;
        activeImage.height = item.height;
        // Match the contained image, including portrait photos, without requesting full originals.
        const ratio = item.width / item.height;
        const sizes = `(max-width: 39.99rem) min(calc(96vw - 1.5rem), calc((86svh - 15rem) * ${ratio})), min(calc(94vw - 9.5rem), calc(72rem - 9.5rem), calc((86svh - 12rem) * ${ratio}))`;

        const preloader = new Image();
        pendingImage = preloader;
        preloader.onload = () => {
          if (currentReq !== requestId || !activeDialog.open) return;
          pendingImage = null;
          if (viewport) viewport.classList.remove('is-loading');
          viewport?.setAttribute('aria-busy', 'false');
          activeImage.sizes = sizes;
          activeImage.srcset = item.srcset;
          activeImage.src = item.src;
          activeImage.hidden = false;
          if (errorBox) errorBox.hidden = true;
          const pendingFlip = flip;
          flip = null;
          if (pendingFlip && performance.now() - pendingFlip.openedAt <= FLIGHT_LOAD_WINDOW_MS) {
            flyIn(pendingFlip.card);
          }
        };

        preloader.onerror = () => {
          if (currentReq !== requestId || !activeDialog.open) return;
          pendingImage = null;
          if (viewport) viewport.classList.remove('is-loading');
          viewport?.setAttribute('aria-busy', 'false');
          activeImage.hidden = true;
          if (errorBox) errorBox.hidden = false;
        };

        preloader.sizes = sizes;
        preloader.srcset = item.srcset;
        preloader.src = item.src;
      };

      // Transform and clip that put the viewer image over a card photo, or null when the card is off screen.
      const cardCrop = (card: HTMLElement | undefined) => {
        const frame = card?.getBoundingClientRect();
        const photo = card?.querySelector('picture')?.getBoundingClientRect();
        const shown = activeImage.getBoundingClientRect();
        if (!frame || !photo || !shown.width || !shown.height) return null;
        const onScreen =
          frame.right > 0 && frame.left < innerWidth && frame.bottom > 0 && frame.top < innerHeight;
        if (!onScreen) return null;
        // Scale to the photo box (frame plus bleed) so the flight starts on the resting crop.
        const scale = Math.max(photo.width / shown.width, photo.height / shown.height);
        const dx = frame.left + frame.width / 2 - (shown.left + shown.width / 2);
        const dy = frame.top + frame.height / 2 - (shown.top + shown.height / 2);
        const insetX = (shown.width - frame.width / scale) / 2;
        const insetY = (shown.height - frame.height / scale) / 2;
        return {
          transform: `translate(${dx}px, ${dy}px) scale(${scale})`,
          clipPath: `inset(${insetY}px ${insetX}px)`,
        };
      };

      const canFly = () => !reducedMotion.matches && typeof activeImage.animate === 'function';

      const runFlight = (
        keyframes: Keyframe[],
        timing: KeyframeAnimationOptions,
        onDone?: () => void,
      ) => {
        stopFlight();
        activeDialog.classList.add('is-flipping');
        const animation = activeImage.animate(keyframes, { easing: FLIGHT_EASING, ...timing });
        flight = animation;
        animation.onfinish = () => {
          animation.cancel();
          flight = null;
          activeDialog.classList.remove('is-flipping');
          onDone?.();
        };
      };

      // Stops a running flight. A cancelled close still finishes, so the dialog never stays half-closed.
      const stopFlight = () => {
        if (!flight) return;
        flight.cancel();
        flight = null;
        activeDialog.classList.remove('is-flipping');
        if (closing) activeDialog.close();
      };

      const flyIn = (card: HTMLElement) => {
        const start = cardCrop(card);
        if (!start || !activeDialog.open || !canFly()) return;
        // Keep full opacity: the image may still be fading in from its loading state.
        runFlight(
          [
            { ...start, opacity: 1 },
            { transform: 'none', clipPath: 'inset(0px)', opacity: 1 },
          ],
          { duration: FLIGHT_OPEN_MS },
        );
      };

      const openDialog = (index: number, trigger: HTMLElement) => {
        if (closing || activeDialog.open || index < 0) return;
        // Let the original link work if native modal opening is unavailable or rejected.
        activeDialog.showModal();
        triggerElement = trigger;
        renderSlide(index);
        flip = { card: trigger, openedAt: performance.now() };
        closeBtn?.focus();
      };

      // Escape, the close button and a backdrop click all end here.
      const closeDialog = () => {
        if (closing || !activeDialog.open) return;
        stopFlight();
        cancelLoad();
        flip = null;
        closing = true;
        const end = !activeImage.hidden && canFly() ? cardCrop(activeCard()) : null;
        if (!end) {
          activeDialog.close();
          return;
        }
        runFlight(
          [{ transform: 'none', clipPath: 'inset(0px)' }, end],
          { duration: FLIGHT_CLOSE_MS, fill: 'forwards' },
          () => activeDialog.close(),
        );
      };

      cards.forEach((card) => {
        card.addEventListener(
          'click',
          (e) => {
            if (typeof activeDialog.showModal !== 'function') {
              // Native showModal unsupported: do not prevent default full-image link navigation
              return;
            }
            // Keep browser handling for modified or non-primary clicks (new tab, new window, download)
            if (e.button !== 0 || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
            const idx = parseInt(card.getAttribute('data-index') || '0', 10);
            const visibleIndex = visibleItems.findIndex((item) => item.index === idx);
            if (visibleIndex < 0) return;
            try {
              openDialog(visibleIndex, card);
              e.preventDefault();
            } catch {
              // The ordinary href is still the source photo.
            }
          },
          listenerOptions,
        );
      });

      closeBtn?.addEventListener('click', closeDialog, listenerOptions);
      prevBtn?.addEventListener('click', () => renderSlide(activeIndex - 1), listenerOptions);
      nextBtn?.addEventListener('click', () => renderSlide(activeIndex + 1), listenerOptions);

      activeDialog.addEventListener(
        'click',
        (e) => {
          if (e.target === activeDialog) {
            closeDialog();
          }
        },
        listenerOptions,
      );

      // Escape and other native close requests take the same animated close path.
      activeDialog.addEventListener(
        'cancel',
        (e) => {
          e.preventDefault();
          closeDialog();
        },
        listenerOptions,
      );

      activeDialog.addEventListener(
        'close',
        () => {
          if (activeDialog.open) return;
          // A forced native close can arrive mid-flight; drop the flight without closing again.
          closing = false;
          stopFlight();
          cancelLoad();
          flip = null;
          if (triggerElement?.isConnected) triggerElement.focus({ preventScroll: true });
        },
        listenerOptions,
      );

      activeDialog.addEventListener(
        'keydown',
        (e) => {
          if (visibleItems.length < 2) return;
          if (e.key === 'ArrowLeft') {
            e.preventDefault();
            renderSlide(activeIndex - 1);
          } else if (e.key === 'ArrowRight') {
            e.preventDefault();
            renderSlide(activeIndex + 1);
          }
        },
        listenerOptions,
      );

      const syncFilter = () => {
        if (!filterLinks.length) return;
        const selected = filterLinks.find((link) => link.hash === location.hash) ?? filterLinks[0]!;
        const value = selected.dataset.galleryFilter!;
        if (value === selectedCategory) return;
        if (activeDialog.open) {
          closing = false;
          stopFlight();
          cancelLoad();
          triggerElement = selected;
          activeDialog.close();
        }
        selectedCategory = value;
        visibleItems = value === 'all' ? items : items.filter((item) => item.categoryKey === value);
        activeIndex = 0;
        rows.forEach((row) => {
          row.hidden = value !== 'all' && row.dataset.category !== value;
        });
        filterLinks.forEach((link) => {
          if (link === selected) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        });
        if (status) {
          status.hidden = false;
          status.textContent = `${selected.querySelector('[data-filter-label]')?.textContent ?? ''} — ${visibleItems.length} / ${items.length}`;
        }
      };
      filterLinks.forEach((link) => {
        link.addEventListener(
          'click',
          (event) => {
            if (
              event.button !== 0 ||
              event.metaKey ||
              event.ctrlKey ||
              event.shiftKey ||
              event.altKey
            )
              return;
            event.preventDefault();
            // Use Astro's router so its history index and scroll restoration stay intact.
            void navigate(link.href)
              .then(() => {
                filters.forEach((sync) => sync());
              })
              .catch(() => {
                location.href = link.href;
              });
          },
          listenerOptions,
        );
      });

      stops.add(stopFlight);
      filters.add(syncFilter);
      disposals.add(() => {
        controller.abort();
        cancelLoad();
        flip = null;
        triggerElement = null;
        closing = false;
        stopFlight();
        if (activeDialog.open) activeDialog.close();
      });
      syncFilter();
    });
  }

  initGalleries();
  document.addEventListener('astro:after-swap', initGalleries);
  document.addEventListener('astro:page-load', initGalleries);
  export {};
</script>

<style>
  .gallery-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-bottom: 1rem;
  }

  .gallery-filters a {
    display: inline-flex;
