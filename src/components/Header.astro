---
import { Image } from 'astro:assets';
import logo from '../assets/brand/wordpress-logo.png';
import { getContact, getServices } from '../content.ts';
import { pageUrl, type Language, type PageId } from '../lib/urls.ts';
import Icon from './Icon.astro';
import ProductIcon from './ProductIcon.astro';
import ContactLink from './ContactLink.astro';
interface Props {
  lang: Language;
  page: PageId;
}
const { lang, page } = Astro.props;
const base = import.meta.env.BASE_URL;
const [contact, services] = await Promise.all([getContact(), getServices()]);
const nav = [
  ['services', lang === 'cs' ? 'Služby' : 'Services'],
  ['gallery', lang === 'cs' ? 'Galerie' : 'Gallery'],
  ['contact', lang === 'cs' ? 'Kontakt' : 'Contact'],
] as const;
const products = {
  label: lang === 'cs' ? 'Produkty' : 'Products',
  all: lang === 'cs' ? 'Všechny produkty' : 'All products',
  current: page === 'products' || services.some(({ slug }) => slug === page),
  links: services.map(({ slug, title_cs, title_en }) => ({
    slug,
    href: pageUrl(slug, lang, base),
    title: lang === 'cs' ? title_cs : title_en,
    current: page === slug,
  })),
};
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={pageUrl('home', lang, base)}>
      <Image src={logo} alt="" width={64} height={64} class="brand-logo" />
      <span class="brand-name">Skloservis Brod</span>
    </a>
    <nav class="desktop-nav" aria-label={lang === 'cs' ? 'Hlavní navigace' : 'Main navigation'}>
      <details class="nav-products" data-disclosure data-hover-open>
        <summary data-current={products.current ? '' : undefined}>
          <span>{products.label}</span>
          <Icon name="chevron-down" />
        </summary>
        <div class="products-panel">
          <ul>
            {products.links.map(({ slug, href, title, current }, index) => (
              <li style={`--i: ${index}`}>
                <a href={href} aria-current={current ? 'page' : undefined}>
                  <span class="products-panel__glyph">
                    <ProductIcon slug={slug} />
                  </span>
                  <span class="products-panel__title">{title}</span>
                  <Icon name="arrow-right" />
                </a>
              </li>
            ))}
          </ul>
          <a
            class="products-panel__all"
            href={pageUrl('products', lang, base)}
            aria-current={page === 'products' ? 'page' : undefined}
          >
            {products.all}
            <Icon name="arrow-right" />
          </a>
        </div>
      </details>
      {nav.map(([id, label]) => (
        <a href={pageUrl(id, lang, base)} aria-current={page === id ? 'page' : undefined}>
          {label}
        </a>
      ))}
    </nav>
    <div class="tools">
      <ContactLink class="header-phone" value={contact.phone} kind="phone" lang={lang}>
        <Icon name="phone" />
        {lang === 'cs' ? 'Zavolat' : 'Call us'}
      </ContactLink>
      <nav class="language-nav" aria-label={lang === 'cs' ? 'Jazyk' : 'Language'}>
        {(['cs', 'en'] as const).map((language) =>
          language === lang ? (
            <span class="language-nav__item" lang={language} aria-current="page" tabindex="-1">
              {language === 'cs' ? 'CZ' : 'EN'}
              <span class="language-indicator" aria-hidden="true"></span>
            </span>
          ) : (
            <a
              class="language-nav__item"
              href={pageUrl(page, language, base)}
              data-language={language}
              hreflang={language}
              lang={language}
            >
              {language === 'cs' ? 'CZ' : 'EN'}
            </a>
          ),
        )}
      </nav>
      <button
        class="theme-toggle"
        data-theme-toggle
        hidden
        aria-pressed="false"
        aria-label={
          lang === 'cs' ? 'Přepnout světlý a tmavý vzhled' : 'Toggle light and dark theme'
        }
      >
        <svg
          class="icon-moon"
          width="21"
          height="21"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
        >
          <path d="M20.5 13a8.5 8.5 0 0 1-9.5-9.5A8.5 8.5 0 1 0 20.5 13Z" />
        </svg>
        <svg
          class="icon-sun"
          width="21"
          height="21"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>
      <details class="mobile-menu" data-disclosure>
        <summary aria-label={lang === 'cs' ? 'Hlavní nabídka' : 'Main menu'}>
          <Icon name="menu" />
        </summary>
        <nav
          class="mobile-nav"
          aria-label={lang === 'cs' ? 'Mobilní navigace' : 'Mobile navigation'}
        >
          <details class="mobile-products" data-disclosure style="--i: 0">
            <summary class="mobile-link" data-current={products.current ? '' : undefined}>
              {products.label}
              <Icon name="chevron-down" />
            </summary>
            <ul>
              {products.links.map(({ href, title, current }) => (
                <li>
                  <a href={href} aria-current={current ? 'page' : undefined}>
                    {title}
                  </a>
                </li>
              ))}
              <li>
                <a
                  class="mobile-products__all"
                  href={pageUrl('products', lang, base)}
                  aria-current={page === 'products' ? 'page' : undefined}
                >
                  {products.all}
                  <Icon name="arrow-right" />
                </a>
              </li>
            </ul>
          </details>
          {nav.map(([id, label], index) => (
            <a
              class="mobile-link"
              href={pageUrl(id, lang, base)}
              aria-current={page === id ? 'page' : undefined}
              style={`--i: ${index + 1}`}
            >
              {label}
            </a>
          ))}
          <ContactLink
            class="mobile-link"
            value={contact.phone}
            kind="phone"
            lang={lang}
            style={`--i: ${nav.length + 1}`}
          >
            <Icon name="phone" />
            {lang === 'cs' ? 'Zavolat' : 'Call us'}
          </ContactLink>
          <a
            class="button mobile-enquiry"
            href={pageUrl('contact', lang, base)}
            style={`--i: ${nav.length + 2}`}
          >
            <Icon name="mail" />
            {lang === 'cs' ? 'Napsat poptávku' : 'Send an enquiry'}
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    box-shadow: inset 0 -1px var(--glass-edge);
  }
  /* Part of the first-load entrance (see Base.astro and motion.ts): the bar drops into place. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-entry='pending']) .site-header {
      translate: 0 -100%;
    }
    :global(html[data-entry='play']) .site-header {
      animation: header-entry 820ms cubic-bezier(0.16, 1, 0.3, 1) 40ms both;
    }
  }
  @keyframes header-entry {
    from {
      translate: 0 -100%;
    }
  }
  @supports (backdrop-filter: blur(1px)) {
    .site-header {
      background: var(--glass);
      backdrop-filter: blur(var(--frost));
    }
  }
  .header-inner {
    min-height: var(--header-h);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.5rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.15;
    text-decoration: none;
  }
  .brand-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .brand-logo {
    width: 32px;
    height: 32px;
    flex: none;
    transition:
      rotate 420ms var(--ease),
      scale 420ms var(--ease);
  }
  .desktop-nav,
  .tools {
    display: flex;
    align-items: center;
  }
  .desktop-nav {
    justify-content: center;
    gap: 1.6rem;
  }
  .tools {
    gap: 0.75rem;
  }
  /* Two quiet text codes in one colour; the current language carries a thin underline. */
  .language-nav {
    display: flex;
    align-items: center;
  }
  .language-nav__item {
    position: relative;
    display: inline-grid;
    place-items: center;
    min-width: 40px;
    min-height: 44px;
    padding-inline: 0.3rem 0.2rem;
    color: var(--text);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-decoration: none;
  }
  /* Pointing at the other language brightens it and draws its underline; the letters never move.
     The switch itself stays instant: the new page renders with no transition at all. */
  a.language-nav__item {
    color: var(--muted);
    transition: color 220ms var(--ease);
  }
  a.language-nav__item::after {
    position: absolute;
    right: calc(0.2rem + 0.12em);
    bottom: 0.7rem;
    left: 0.3rem;
    height: 1.5px;
    border-radius: 1px;
    background: currentColor;
    content: '';
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 320ms var(--ease);
  }
  a.language-nav__item:focus-visible {
    color: var(--text);
  }
  a.language-nav__item:focus-visible::after {
    transform: scaleX(1);
  }
  @media (hover: hover) and (pointer: fine) {
    a.language-nav__item:hover {
      color: var(--text);
    }
    a.language-nav__item:hover::after {
      transform: scaleX(1);
    }
  }
  .language-nav [aria-current='page'] {
    color: var(--text);
    text-decoration: none;
  }
  .language-indicator {
    position: absolute;
    right: calc(0.2rem + 0.12em);
    bottom: 0.7rem;
    left: 0.3rem;
    height: 1.5px;
    border-radius: 1px;
    background: currentColor;
  }
  .desktop-nav a,
  .nav-products summary {
    text-decoration: none;
    font-weight: 550;
    font-size: 0.92rem;
  }
  .desktop-nav a:hover,
  .nav-products summary:hover,
  .nav-products[open] > summary {
    color: var(--accent);
  }
  /* Top links draw an underline in from the left and retract it the same way. One fixed origin
     lets a quick pass reverse smoothly instead of jumping. The hover target itself never moves. */
  .desktop-nav > a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    transition: color var(--dur-fast) var(--ease);
  }
  .desktop-nav > a[aria-current='page'] {
    text-decoration: none;
  }
  .desktop-nav > a::after,
  .nav-products > summary::after,
  .header-phone::after {
    position: absolute;
    right: 0;
    bottom: 0.55rem;
    left: 0;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
    content: '';
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 380ms var(--ease);
  }
  .desktop-nav > a:focus-visible::after,
  .desktop-nav > a[aria-current='page']::after,
  .nav-products > summary:focus-visible::after,
  .nav-products[open] > summary::after,
  .nav-products > summary[data-current]::after,
  .header-phone:focus-visible::after {
    transform: scaleX(1);
  }
  @media (hover: hover) and (pointer: fine) {
    .desktop-nav > a:hover::after,
    .nav-products > summary:hover::after,
    .header-phone:hover::after {
      transform: scaleX(1);
    }
    .brand:hover .brand-logo {
      rotate: -8deg;
      scale: 1.06;
    }
    .mobile-menu:not([open]) > summary:hover {
      background: var(--surface);
    }
    .mobile-menu:not([open]) > summary:hover :global([data-icon='menu'] path:nth-child(2)) {
      transform: scaleX(0.6);
    }
  }
  .nav-products {
    position: relative;
  }
  .nav-products summary,
  .mobile-products summary {
    cursor: pointer;
    list-style: none;
  }
  .nav-products summary::-webkit-details-marker,
  .mobile-products summary::-webkit-details-marker {
    display: none;
  }
  .nav-products summary {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 44px;
  }
  .nav-products > summary {
    position: relative;
  }
  .nav-products > summary[data-current] {
    color: var(--accent);
  }
  /* The summary underline spans the label only, not the chevron after it. */
  .nav-products > summary::after {
    right: calc(1.1em + 0.3rem);
  }
  /* Opaque pane: the header's backdrop filter would leave a nested blur with nothing to blur. */
  .products-panel {
    position: absolute;
    top: calc(100% + (var(--header-h) - 44px) / 2 + 1px);
    left: -1.25rem;
    display: grid;
    gap: 0.5rem;
    width: min(40rem, calc(100vw - 3rem));
    padding: 0.75rem;
    border: 1px solid var(--line);
    border-top: 0;
    border-radius: 0 0 var(--radius) var(--radius);
    background: var(--bg);
    box-shadow:
      inset 1px 0 var(--glass-edge),
      var(--lift);
  }
  /* Invisible bridge over the gap below the summary, so hover survives the move into the pane. */
  .products-panel::before {
    position: absolute;
    inset: auto 0 100%;
    height: calc((var(--header-h) - 44px) / 2 + 1px);
    content: '';
  }
  .products-panel ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.125rem 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .products-panel a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border-radius: calc(var(--radius) - 2px);
    color: var(--text);
    line-height: 1.3;
    transition:
      background-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }
  .products-panel ul a {
    gap: 0.75rem;
  }
  .products-panel__title {
    flex: 1;
  }
  .products-panel__glyph {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    flex: none;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--glass-solid);
    box-shadow: inset 1px 1px var(--glass-edge);
    color: var(--accent);
    font-size: 0.95rem;
    transition:
      background-color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }
  .products-panel a:hover .products-panel__glyph,
  .products-panel a:focus-visible .products-panel__glyph,
  .products-panel [aria-current='page'] .products-panel__glyph {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--on-accent);
  }
  /* The arrow only fades in; its own nudge is the single motion, so transforms never stack. */
  .products-panel ul a :global([data-icon='arrow-right']) {
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease);
  }
  .products-panel a:hover,
  .products-panel a:focus-visible {
    background: var(--surface);
    color: var(--accent);
  }
  .products-panel ul a:hover :global([data-icon='arrow-right']),
  .products-panel ul a:focus-visible :global([data-icon='arrow-right']) {
    opacity: 1;
  }
  .products-panel [aria-current='page'] {
    color: var(--accent);
    text-decoration: none;
    box-shadow: inset 2px 0 var(--accent);
  }
  .desktop-nav .products-panel__all {
    border-top: 1px solid var(--line);
    border-radius: 0;
    padding-top: 0.75rem;
    color: var(--accent);
    font-weight: 600;
  }
  .nav-products[open] .products-panel {
    animation: header-panel-open 280ms var(--ease) backwards;
  }
  .nav-products[open] li {
    animation: header-panel-item 260ms var(--ease) backwards;
    animation-delay: calc(60ms + var(--i) * 22ms);
  }
  @keyframes header-panel-open {
    from {
      opacity: 0;
      transform: translateY(-8px);
      clip-path: inset(0 -3rem 100% -3rem);
    }
    to {
      opacity: 1;
      transform: none;
      clip-path: inset(0 -3rem -3rem -3rem);
    }
  }
  @keyframes header-panel-item {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
  .header-phone {
    display: none;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    font-size: 0.92rem;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    color: var(--accent);
  }
  .header-phone {
    position: relative;
  }
  .header-phone::after {
    left: calc(1.1em + 0.5rem);
  }
  [aria-current='page'] {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.55rem;
  }
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    position: relative;
    isolation: isolate;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--text);
  }
  /* A soft disc grows behind the theme icon while the visible icon turns a little. */
  .theme-toggle::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    border-radius: 50%;
    background: var(--surface);
    content: '';
    opacity: 0;
    transform: scale(0.4);
    transition:
      transform 320ms var(--ease),
      opacity 200ms var(--ease);
  }
  .theme-toggle:focus-visible::before {
    opacity: 1;
    transform: none;
  }
  .theme-toggle svg {
    grid-area: 1 / 1;
    transition:
      transform 320ms var(--ease),
      opacity var(--dur-fast) var(--ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .theme-toggle:hover::before {
      opacity: 1;
      transform: none;
    }
    .theme-toggle[aria-pressed='false']:hover .icon-moon {
      transform: rotate(-24deg);
    }
    .theme-toggle[aria-pressed='true']:hover .icon-sun {
      transform: rotate(60deg);
    }
  }
  .theme-toggle .icon-sun,
  .theme-toggle[aria-pressed='true'] .icon-moon {
    opacity: 0;
    transform: rotate(-30deg) scale(0.7);
  }
  .theme-toggle[hidden] {
    display: none;
  }
  :global(html[data-theme]) .theme-toggle[hidden] {
    display: grid;
    visibility: hidden;
  }
  .theme-toggle[aria-pressed='true'] .icon-sun {
    opacity: 1;
    transform: none;
  }
  .mobile-menu {
    display: none;
  }
  .mobile-menu > summary {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid transparent;
    border-radius: var(--radius);
    font-size: 1.3rem;
    cursor: pointer;
    list-style: none;
    transition:
      background-color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }
  .mobile-menu > summary::-webkit-details-marker {
    display: none;
  }
  .mobile-menu[open] > summary {
    border-color: var(--line);
    background: var(--glass-solid);
    box-shadow: inset 0 1px var(--glass-edge);
  }
  .mobile-menu[open] .mobile-nav {
    animation: header-menu-open 320ms var(--ease) backwards;
  }
  .mobile-menu[open] .mobile-nav > * {
    animation: header-panel-item 280ms var(--ease) backwards;
    animation-delay: calc(60ms + var(--i) * 35ms);
  }
  @keyframes header-menu-open {
    from {
      opacity: 0.4;
      clip-path: inset(0 0 100% 0);
    }
    to {
      opacity: 1;
      clip-path: inset(0);
    }
  }
  .mobile-nav {
    position: absolute;
    inset: 100% 0 auto;
    display: grid;
    padding: 0.25rem 1rem 1rem;
    max-height: calc(100svh - var(--header-h));
    overflow-y: auto;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .mobile-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 48px;
    font-weight: 550;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .mobile-products > summary {
    justify-content: space-between;
  }
  .mobile-products > summary[data-current] {
    color: var(--accent);
  }
  .mobile-products[open] > summary {
    border-bottom-color: transparent;
  }
  .mobile-products ul {
    margin: 0;
    padding: 0 0 0.5rem 1rem;
    border-bottom: 1px solid var(--line);
    list-style: none;
  }
  .mobile-products[open] ul {
    animation: header-panel-item 240ms var(--ease) backwards;
  }
  .mobile-products a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    color: var(--text);
    text-decoration: none;
  }
  .mobile-products [aria-current='page'] {
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }
  .mobile-products .mobile-products__all {
    color: var(--accent);
    font-weight: 600;
  }
  .mobile-enquiry {
    margin-top: 1rem;
  }
  @media (min-width: 70rem) {
    .header-phone {
      display: inline-flex;
    }
  }
  @media (max-width: 950px) {
    .desktop-nav {
      display: none;
    }
    .mobile-menu {
      display: block;
    }
    .header-inner {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.5rem;
    }
    .brand-name {
      font-size: 1rem;
    }
    .tools {
      gap: 0.5rem;
    }
  }
  @media (max-width: 359px) {
    .brand-logo {
      display: none;
    }
    .tools {
      gap: 0.375rem;
    }
  }
</style>
<script>
  // Native details stay usable without JS; this adds Escape, outside-click and focus-leave closing.
  const openDisclosures = () =>
    document.querySelectorAll<HTMLDetailsElement>('details[data-disclosure][open]');

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !(event.target instanceof Element)) return;
    // A panel opened by hover alone has no focus inside it, so fall back to it directly.
    const disclosure =
      event.target.closest<HTMLDetailsElement>('details[data-disclosure][open]') ??
      document.querySelector<HTMLDetailsElement>('details[data-hover-open][open]');
    if (!disclosure) return;
    const hadFocus = disclosure.contains(document.activeElement);
    disclosure.open = false;
    if (hadFocus) disclosure.querySelector<HTMLElement>(':scope > summary')?.focus();
  });
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Node)) return;
    for (const disclosure of openDisclosures()) {
      if (!disclosure.contains(event.target)) disclosure.open = false;
    }
  });
  document.addEventListener('focusout', ({ target, relatedTarget }) => {
    if (!(target instanceof Node) || !(relatedTarget instanceof Node)) return;
    for (const disclosure of openDisclosures()) {
      // Nested product lists stay open while focus moves through the rest of the mobile menu.
      if (disclosure.parentElement?.closest('details[data-disclosure]')) continue;
      if (disclosure.contains(target) && !disclosure.contains(relatedTarget))
        disclosure.open = false;
    }
  });

  // A resting mouse opens the desktop product panel; clicking the summary then pins it open.
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  const hoverTimers = new WeakMap<HTMLDetailsElement, number>();
  const hoverDisclosure = (event: PointerEvent) => {
    const disclosure =
      event.target instanceof Element
        ? event.target.closest<HTMLDetailsElement>('details[data-hover-open]')
        : null;
    if (!disclosure || event.pointerType !== 'mouse') return;
    if (disclosure.contains(event.relatedTarget as Node | null)) return;
    return disclosure;
  };
  const schedule = (disclosure: HTMLDetailsElement, delay: number, action: () => void) => {
    window.clearTimeout(hoverTimers.get(disclosure));
    hoverTimers.set(disclosure, window.setTimeout(action, delay));
  };

  document.addEventListener('pointerover', (event) => {
    const disclosure = hoverDisclosure(event);
    if (!disclosure || !finePointer.matches) return;
    schedule(disclosure, 90, () => {
      if (disclosure.open || !disclosure.isConnected) return;
      disclosure.dataset.hovered = '';
      disclosure.open = true;
    });
  });
  document.addEventListener('pointerout', (event) => {
    const disclosure = hoverDisclosure(event);
    if (!disclosure) return;
    schedule(disclosure, 240, () => {
      if (disclosure.hasAttribute('data-hovered') && !disclosure.contains(document.activeElement))
        disclosure.open = false;
    });
  });
  document.addEventListener('click', (event) => {
    const summary =
      event.target instanceof Element
        ? event.target.closest('details[data-hover-open][data-hovered] > summary')
        : null;
    if (!summary) return;
    event.preventDefault();
    summary.parentElement?.removeAttribute('data-hovered');
  });
  document.addEventListener(
    'toggle',
    (event) => {
      if (event.target instanceof HTMLDetailsElement && !event.target.open)
        event.target.removeAttribute('data-hovered');
    },
    true,
  );
</script>
