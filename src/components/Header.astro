---
import { Image } from 'astro:assets';
import logo from '../assets/brand/wordpress-logo.png';
import { getContact } from '../content.ts';
import { pageUrl, type Language, type PageId } from '../lib/urls.ts';
import Icon from './Icon.astro';
interface Props {
  lang: Language;
  page: PageId;
}
const { lang, page } = Astro.props;
const base = import.meta.env.BASE_URL;
const contact = await getContact();
const phone = contact.phone.replace(/^(\+\d{3})(\d{3})(\d{3})(\d{3})$/, '$1 $2 $3 $4');
const nav = [
  ['products', lang === 'cs' ? 'Produkty' : 'Products'],
  ['services', lang === 'cs' ? 'Služby' : 'Services'],
  ['gallery', lang === 'cs' ? 'Galerie' : 'Gallery'],
  ['contact', lang === 'cs' ? 'Kontakt' : 'Contact'],
] as const;
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={pageUrl('home', lang, base)}>
      <Image src={logo} alt="" width={64} height={64} class="brand-logo" />
      <span class="brand-name">Skloservis Brod</span>
    </a>
    <nav class="desktop-nav" aria-label={lang === 'cs' ? 'Hlavní navigace' : 'Main navigation'}>
      {nav.map(([id, label]) => (
        <a href={pageUrl(id, lang, base)} aria-current={page === id ? 'page' : undefined}>
          {label}
        </a>
      ))}
    </nav>
    <div class="tools">
      <a class="header-phone" href={`tel:${contact.phone}`}>
        <Icon name="phone" />
        {phone}
      </a>
      <nav class="language-nav" aria-label={lang === 'cs' ? 'Jazyk' : 'Language'}>
        {(['cs', 'en'] as const).map((language) =>
          language === lang ? (
            <span lang={language} aria-current="page" tabindex="-1">
              {language === 'cs' ? 'CZ' : 'EN'}
            </span>
          ) : (
            <a href={pageUrl(page, language, base)} data-language={language} lang={language}>
              {language === 'cs' ? 'CZ' : 'EN'}
            </a>
          ),
        )}
      </nav>
      <button
        class="theme-toggle"
        data-theme-toggle
        hidden
        aria-pressed="false"
        aria-label={
          lang === 'cs' ? 'Přepnout světlý a tmavý vzhled' : 'Toggle light and dark theme'
        }
      >
        <svg
          class="icon-moon"
          width="21"
          height="21"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
        >
          <path d="M20.5 13a8.5 8.5 0 0 1-9.5-9.5A8.5 8.5 0 1 0 20.5 13Z" />
        </svg>
        <svg
          class="icon-sun"
          width="21"
          height="21"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>
      <details class="mobile-menu">
        <summary aria-label={lang === 'cs' ? 'Otevřít navigaci' : 'Open navigation'}>
          <svg
            width="23"
            height="23"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            aria-hidden="true"
          >
            <path d="M3 6h18M3 12h18M3 18h18" />
          </svg>
        </summary>
        <nav
          class="mobile-nav"
          aria-label={lang === 'cs' ? 'Mobilní navigace' : 'Mobile navigation'}
        >
          {nav.map(([id, label]) => (
            <a
              class="mobile-link"
              href={pageUrl(id, lang, base)}
              aria-current={page === id ? 'page' : undefined}
            >
              {label}
            </a>
          ))}
          <a class="mobile-link" href={`tel:${contact.phone}`}>
            <Icon name="phone" />
            {phone}
          </a>
          <a class="button mobile-enquiry" href={pageUrl('contact', lang, base)}>
            <Icon name="mail" />
            {lang === 'cs' ? 'Napsat poptávku' : 'Send an enquiry'}
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  @supports (backdrop-filter: blur(1px)) {
    .site-header {
      background: color-mix(in srgb, var(--bg) 84%, transparent);
      backdrop-filter: blur(14px);
    }
  }
  .header-inner {
    min-height: var(--header-h);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.5rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.15;
    text-decoration: none;
  }
  .brand-logo {
    width: 32px;
    height: 32px;
    flex: none;
  }
  .desktop-nav,
  .tools,
  .language-nav {
    display: flex;
    align-items: center;
  }
  .desktop-nav {
    justify-content: center;
    gap: 1.6rem;
  }
  .tools {
    gap: 0.75rem;
  }
  .language-nav {
    gap: 0.75rem;
  }
  .desktop-nav a,
  .language-nav a,
  .language-nav span {
    text-decoration: none;
    font-weight: 550;
    font-size: 0.92rem;
  }
  .desktop-nav a:hover,
  .language-nav a:hover {
    color: var(--accent);
  }
  .language-nav a,
  .language-nav span {
    display: inline-grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
  }
  .header-phone {
    display: none;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    font-size: 0.92rem;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    color: var(--accent);
  }
  [aria-current='page'] {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.55rem;
  }
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: transparent;
    color: var(--text);
  }
  .theme-toggle svg {
    grid-area: 1 / 1;
    transition:
      transform var(--dur-fast) var(--ease),
      opacity var(--dur-fast) var(--ease);
  }
  .theme-toggle .icon-sun,
  .theme-toggle[aria-pressed='true'] .icon-moon {
    opacity: 0;
    transform: rotate(-30deg) scale(0.7);
  }
  .theme-toggle[hidden] {
    display: none;
  }
  :global(html[data-theme]) .theme-toggle[hidden] {
    display: grid;
    visibility: hidden;
  }
  .theme-toggle[aria-pressed='true'] .icon-sun {
    opacity: 1;
    transform: none;
  }
  .mobile-menu {
    display: none;
  }
  .mobile-menu summary {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    cursor: pointer;
    list-style: none;
  }
  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }
  .mobile-nav {
    position: absolute;
    inset: 100% 0 auto;
    display: grid;
    padding: 0.25rem 1rem 1rem;
    max-height: calc(100svh - var(--header-h));
    overflow-y: auto;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .mobile-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 48px;
    font-weight: 550;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .mobile-enquiry {
    margin-top: 1rem;
  }
  @media (min-width: 70rem) {
    .header-phone {
      display: inline-flex;
    }
  }
  @media (max-width: 950px) {
    .desktop-nav {
      display: none;
    }
    .mobile-menu {
      display: block;
    }
    .header-inner {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.5rem;
    }
    .brand-name {
      font-size: 1rem;
    }
    .tools {
      gap: 0.5rem;
    }
    .language-nav {
      gap: 0.375rem;
    }
  }
  @media (max-width: 359px) {
    .brand-logo {
      display: none;
    }
    .tools {
      gap: 0.375rem;
    }
  }
</style>
<script>
  // Escape closes the mobile menu and returns focus to its toggle.
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !(event.target instanceof Element)) return;
    const menu = event.target.closest<HTMLDetailsElement>('.mobile-menu');
    if (!menu?.open) return;
    menu.open = false;
    menu.querySelector('summary')?.focus();
  });
</script>
