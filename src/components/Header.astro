---
import { pageUrl, type Language, type PageId } from '../lib/urls.ts';
interface Props {
  lang: Language;
  page: PageId;
}
const { lang, page } = Astro.props;
const base = import.meta.env.BASE_URL;
const nav = [
  ['products', lang === 'cs' ? 'Produkty' : 'Products'],
  ['services', lang === 'cs' ? 'Služby' : 'Services'],
  ['gallery', lang === 'cs' ? 'Galerie' : 'Gallery'],
  ['contact', lang === 'cs' ? 'Kontakt' : 'Contact'],
] as const;
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={pageUrl('home', lang, base)} aria-label="Skloservis Brod">
      <span class="brand-mark" aria-hidden="true">
        SB
      </span>
      <span>Skloservis Brod</span>
    </a>
    <nav class="desktop-nav" aria-label={lang === 'cs' ? 'Hlavní navigace' : 'Main navigation'}>
      {nav.map(([id, label]) => (
        <a href={pageUrl(id, lang, base)} aria-current={page === id ? 'page' : undefined}>
          {label}
        </a>
      ))}
    </nav>
    <div class="tools">
      <nav class="language-nav" aria-label={lang === 'cs' ? 'Jazyk' : 'Language'}>
        {(['cs', 'en'] as const).map((language) => (
          <a
            href={pageUrl(page, language, base)}
            data-language={language}
            lang={language}
            aria-current={language === lang ? 'page' : undefined}
          >
            {language === 'cs' ? 'CZ' : 'EN'}
          </a>
        ))}
      </nav>
      <button
        class="theme-toggle"
        data-theme-toggle
        aria-pressed="false"
        aria-label={
          lang === 'cs' ? 'Přepnout světlý a tmavý vzhled' : 'Toggle light and dark theme'
        }
      >
        <svg
          width="21"
          height="21"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
        >
          <path d="M20.5 13a8.5 8.5 0 0 1-9.5-9.5A8.5 8.5 0 1 0 20.5 13Z" />
        </svg>
      </button>
      <details class="mobile-menu">
        <summary aria-label={lang === 'cs' ? 'Otevřít navigaci' : 'Open navigation'}>
          <svg
            width="23"
            height="23"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            aria-hidden="true"
          >
            <path d="M3 6h18M3 12h18M3 18h18" />
          </svg>
        </summary>
        <nav aria-label={lang === 'cs' ? 'Mobilní navigace' : 'Mobile navigation'}>
          {nav.map(([id, label]) => (
            <a href={pageUrl(id, lang, base)} aria-current={page === id ? 'page' : undefined}>
              {label}
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    min-height: 86px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 1.2rem;
    letter-spacing: -0.035em;
    font-weight: 700;
    white-space: nowrap;
    text-decoration: none;
  }
  .brand-mark {
    color: var(--accent);
    font-size: 1.75rem;
    letter-spacing: -0.22em;
    padding-right: 0.3em;
    font-style: italic;
  }
  .desktop-nav,
  .tools,
  .language-nav {
    display: flex;
    align-items: center;
    gap: 1.6rem;
  }
  .desktop-nav a,
  .language-nav a {
    text-decoration: none;
    font-weight: 550;
    font-size: 0.92rem;
  }
  .desktop-nav a:hover,
  .language-nav a:hover {
    color: var(--accent);
  }
  a[aria-current='page'] {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.55rem;
  }
  .language-nav {
    gap: 0.75rem;
  }
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    color: var(--text);
  }
  .mobile-menu {
    display: none;
  }
  .mobile-menu summary {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    cursor: pointer;
    list-style: none;
  }
  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }
  .mobile-menu nav {
    position: absolute;
    inset: 100% 0 auto;
    padding: 1rem 1.5rem 1.5rem;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    display: grid;
    gap: 1rem;
  }
  .mobile-menu nav a {
    padding: 0.5rem 0;
    text-decoration: none;
  }
  @media (max-width: 950px) {
    .desktop-nav {
      display: none;
    }
    .mobile-menu {
      display: block;
    }
    .header-inner {
      min-height: 74px;
      gap: 1rem;
    }
    .tools {
      gap: 0.8rem;
    }
  }
  @media (max-width: 460px) {
    .brand {
      font-size: 1rem;
      gap: 0.35rem;
    }
    .brand-mark {
      font-size: 1.4rem;
    }
    .tools {
      gap: 0.35rem;
    }
    .language-nav {
      gap: 0.45rem;
    }
    .theme-toggle {
      width: 36px;
      height: 36px;
    }
    .header-inner {
      gap: 0.5rem;
    }
  }
</style>
