---
import { Picture } from 'astro:assets';
import { getAbout, getContact, getGallery, getServices, getSettings } from '../content';
import { pageUrl, type Language, type ServiceSlug } from '../lib/urls';
import Contact from './Contact.astro';
import Gallery from './Gallery.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const [settings, services, gallery, about, contact] = await Promise.all([
  getSettings(),
  getServices(),
  getGallery(),
  getAbout(),
  getContact(),
]);
const url = (page: Parameters<typeof pageUrl>[0]) => pageUrl(page, lang, import.meta.env.BASE_URL);
const phone = contact.phone.replace(/^(\+420)(\d{3})(\d{3})(\d{3})$/, '$1 $2 $3 $4');
const labels = {
  cs: {
    enquiry: 'Nezávazná poptávka',
    projects: 'Ukázky naší práce',
    call: 'Zavolejte',
    products: 'Všechny produkty',
    process: 'Jak probíhá zakázka',
    steps: ['Návrh', 'Zaměření', 'Výroba', 'Montáž'],
    services: 'Více o našich službách',
  },
  en: {
    enquiry: 'Project enquiry',
    projects: 'View our work',
    call: 'Call us',
    products: 'All products',
    process: 'How your project takes shape',
    steps: ['Planning', 'Measuring', 'Manufacture', 'Installation'],
    services: 'Explore our services',
  },
}[lang];
const hero = gallery.find((item) => item.image.src.includes('office-glass-corridor')) ?? gallery[0];
const featuredSlugs: ServiceSlug[] = [
  'sklenene-dvere',
  'sklenene-zabradli',
  'skleneny-sprchovy-kout',
  'skleneny-obklad-do-kuchyne',
];
const featured = featuredSlugs.map((slug) => {
  const service = services.find((item) => item.slug === slug);
  if (!service) throw new Error(`Missing validated service: ${slug}`);
  return { service, photo: gallery.find((item) => item.category === slug) };
});
const paragraphs = about[`body_${lang}`].trim().split(/\n\s*\n/);
---

<section class="home-hero" aria-labelledby="home-title">
  <div class="home-hero__copy">
    <h1 id="home-title">{settings[`hero_title_${lang}`]}</h1>
    <p class="lead">{settings[`hero_text_${lang}`]}</p>
    <div class="home-actions">
      <a class="button" href={url('contact')}>
        {labels.enquiry}
      </a>
      <a class="button button--secondary" href={url('gallery')}>
        {labels.projects}
      </a>
    </div>
    <p class="home-call muted">
      {labels.call}
      <a class="text-link" href={`tel:${contact.phone}`}>
        {phone}
      </a>
    </p>
  </div>
  {hero && (
    <figure class="home-hero__media">
      <Picture
        src={hero.image}
        alt={hero[`alt_${lang}`]}
        formats={['avif', 'webp']}
        widths={[400, 720, 1000, hero.image.width].filter(
          (width, index, all) => width <= hero.image.width && all.indexOf(width) === index,
        )}
        sizes="(min-width: 48rem) 50vw, 100vw"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </figure>
  )}
</section>

<section class="section home-products" aria-labelledby="home-products-title">
  <div class="wrap">
    <div class="home-section-heading">
      <h2 class="section-title" id="home-products-title">
        {settings[`products_title_${lang}`]}
      </h2>
      <p class="muted">{settings[`products_text_${lang}`]}</p>
    </div>
    <div class="home-product-grid">
      {featured.map(({ service, photo }) => (
        <a class="home-product" href={url(service.slug)} aria-labelledby={`home-${service.slug}`}>
          {photo && (
            <span class="home-product__media">
              <Picture
                src={photo.image}
                alt={photo[`alt_${lang}`]}
                formats={['avif', 'webp']}
                widths={[280, 480, 640].filter((width) => width <= photo.image.width)}
                sizes="(min-width: 70rem) 18rem, (min-width: 48rem) 23vw, (min-width: 30rem) 46vw, 100vw"
                loading="lazy"
                decoding="async"
              />
            </span>
          )}
          <h3 id={`home-${service.slug}`}>
            {service[`title_${lang}`]}
            <span class="home-product__arrow" aria-hidden="true">
              →
            </span>
          </h3>
        </a>
      ))}
    </div>
    <a class="text-link home-all-products" href={url('products')}>
      {labels.products}
    </a>
  </div>
</section>

<Gallery lang={lang} compact />

<section class="section home-company" aria-labelledby="home-about-title">
  <div class="wrap home-company__grid">
    <div>
      <h2 class="section-title" id="home-about-title">
        {about[`title_${lang}`]}
      </h2>
      <p class="lead">{about[`lead_${lang}`]}</p>
      {paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
    <div class="home-process">
      <h2 class="section-title">{labels.process}</h2>
      <ol class="home-steps">
        {labels.steps.map((step) => (
          <li>{step}</li>
        ))}
      </ol>
      <p>{settings[`process_${lang}`]}</p>
      <a class="text-link" href={url('services')}>
        {labels.services}
      </a>
    </div>
  </div>
</section>

<Contact lang={lang} compact />

<style>
  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: stretch;
    min-height: 42rem;
    min-height: min(42rem, 78svh);
  }

  .home-hero__copy {
    align-self: center;
    padding: clamp(3rem, 6vw, 6rem) clamp(1.5rem, 4vw, 4rem) clamp(3rem, 6vw, 6rem)
      max(1.5rem, calc((100vw - 1240px) / 2));
  }

  @media (prefers-reduced-motion: no-preference) {
    .home-hero__copy {
      animation: home-hero-rise 480ms var(--ease, cubic-bezier(0.2, 0.7, 0.2, 1)) both;
    }
  }

  @keyframes home-hero-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .home-hero h1 {
    max-width: 13ch;
    margin: 0 0 1.5rem;
    font-size: clamp(2.75rem, 4.7vw, 4.6rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
    text-wrap: balance;
    overflow-wrap: normal;
  }

  .home-hero .lead {
    max-width: 38ch;
  }

  .home-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .home-call {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.6rem;
    margin-top: 1.5rem;
  }

  .home-call .text-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .home-hero__media {
    min-width: 0;
    margin: 0;
  }

  .home-hero__media :global(picture) {
    display: block;
    height: 100%;
  }

  .home-hero__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% center;
  }

  .home-products,
  .home-company {
    background: var(--surface, #edf7fa);
  }

  .home-section-heading {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
    margin-bottom: 2rem;
  }

  .home-section-heading p {
    max-width: 48ch;
    margin-top: 0;
    justify-self: end;
  }

  .home-product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .home-product {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .home-product__media {
    display: block;
    overflow: hidden;
  }

  .home-product :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transition: transform 480ms var(--ease, cubic-bezier(0.2, 0.7, 0.2, 1));
  }

  .home-product:hover :global(img) {
    transform: scale(1.03);
  }

  .home-product h3 {
    margin: 1rem 0 0;
    font-size: 1.1rem;
    line-height: 1.4;
    text-wrap: balance;
  }

  .home-product__arrow {
    display: inline-block;
    margin-left: 0.4em;
    transition: transform var(--dur-fast, 160ms) var(--ease, cubic-bezier(0.2, 0.7, 0.2, 1));
  }

  .home-product:hover .home-product__arrow {
    transform: translateX(3px);
  }

  .home-product:focus-visible {
    outline: 3px solid var(--accent, #087fa0);
    outline-offset: 5px;
  }

  .home-all-products {
    display: inline-block;
    margin-top: 2rem;
  }

  .home-company__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 7vw, 7rem);
  }

  .home-company__grid p {
    max-width: 65ch;
  }

  .home-process {
    border-left: 1px solid var(--line, #cedfe5);
    padding-left: clamp(1.5rem, 3vw, 3rem);
  }

  .home-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
    gap: 1.5rem 1rem;
    margin: 0 0 2rem;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .home-steps li {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    counter-increment: step;
  }

  .home-steps li::before {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--accent, #087fa0);
    border-radius: 50%;
    content: counter(step);
    color: var(--accent, #087fa0);
    font-weight: 600;
  }

  .home-process .text-link {
    display: inline-block;
    margin-top: 1rem;
  }

  @media (max-width: 69.99rem) {
    .home-product-grid {
      gap: 1rem;
    }
  }

  @media (max-width: 47.99rem) {
    .home-hero,
    .home-section-heading,
    .home-company__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .home-hero {
      min-height: 0;
    }

    .home-hero__copy {
      padding: 3rem 1.5rem;
    }

    .home-hero h1 {
      max-width: 17ch;
      font-size: clamp(2.25rem, 9vw, 3rem);
    }

    .home-hero__media :global(picture) {
      height: auto;
    }

    .home-hero__media :global(img) {
      height: auto;
      aspect-ratio: 4 / 3;
    }

    .home-section-heading {
      gap: 0.75rem;
    }

    .home-section-heading p {
      justify-self: start;
    }

    .home-product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.75rem 1rem;
    }

    .home-process {
      border-left: 0;
      border-top: 1px solid var(--line, #cedfe5);
      padding: 2rem 0 0;
    }
  }

  @media (max-width: 640px) {
    .home-hero__copy {
      padding-inline: 1rem;
    }
  }

  @media (max-width: 29.99rem) {
    .home-product-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .home-product :global(img) {
      aspect-ratio: 4 / 3;
    }
  }
</style>
