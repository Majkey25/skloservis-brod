---
import { Picture } from 'astro:assets';
import { getAbout, getContact, getGallery, getServices, getSettings } from '../content';
import { pageUrl, type Language, type ServiceSlug } from '../lib/urls';
import CompanyMetrics from './CompanyMetrics.astro';
import Contact from './Contact.astro';
import Gallery from './Gallery.astro';
import Icon from './Icon.astro';
import ProductIcon from './ProductIcon.astro';
import Reputation from './Reputation.astro';
import ServiceHighlights from './ServiceHighlights.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const [settings, services, gallery, about, contact] = await Promise.all([
  getSettings(),
  getServices(),
  getGallery(),
  getAbout(),
  getContact(),
]);
const url = (page: Parameters<typeof pageUrl>[0]) => pageUrl(page, lang, import.meta.env.BASE_URL);
const phone = contact.phone.replace(/^(\+420)(\d{3})(\d{3})(\d{3})$/, '$1 $2 $3 $4');
const labels = {
  cs: {
    enquiry: 'Nezávazná poptávka',
    projects: 'Ukázky naší práce',
    call: 'Zavolejte',
    products: 'Všechny produkty',
    process: 'Jak probíhá zakázka',
    steps: ['Návrh', 'Zaměření', 'Výroba', 'Montáž'],
    services: 'Více o našich službách',
    about: 'Více o společnosti',
  },
  en: {
    enquiry: 'Project enquiry',
    projects: 'View our work',
    call: 'Call us',
    products: 'All products',
    process: 'How your project takes shape',
    steps: ['Planning', 'Measuring', 'Manufacture', 'Installation'],
    services: 'Explore our services',
    about: 'More about us',
  },
}[lang];
const hero = gallery.find((item) => item.image.src.includes('office-glass-corridor')) ?? gallery[0];
const featuredSlugs: ServiceSlug[] = [
  'sklenene-dvere',
  'sklenene-zabradli',
  'skleneny-sprchovy-kout',
  'skleneny-obklad-do-kuchyne',
];
const featured = featuredSlugs.map((slug) => {
  const service = services.find((item) => item.slug === slug);
  if (!service) throw new Error(`Missing validated service: ${slug}`);
  return { service, photo: gallery.find((item) => item.category === slug) };
});
const otherServices = services.filter((service) => !featuredSlugs.includes(service.slug));
const paragraphs = about[`body_${lang}`].trim().split(/\n\s*\n/);
---

<section class="home-hero" aria-labelledby="home-title">
  <div class="home-hero__copy" data-reveal="hero">
    <h1 id="home-title">{settings[`hero_title_${lang}`]}</h1>
    <p class="lead">{settings[`hero_text_${lang}`]}</p>
    <div class="home-actions">
      <a class="button" href={url('contact')}>
        {labels.enquiry}
      </a>
      <a class="button button--secondary" href={url('gallery')}>
        {labels.projects}
      </a>
    </div>
    <p class="home-call muted">
      {labels.call}
      <a class="text-link" href={`tel:${contact.phone}`}>
        {phone}
      </a>
    </p>
  </div>
  {hero && (
    <figure class="home-hero__media">
      <Picture
        src={hero.image}
        alt={hero[`alt_${lang}`]}
        formats={['avif', 'webp']}
        widths={[400, 720, 1000, hero.image.width].filter(
          (width, index, all) => width <= hero.image.width && all.indexOf(width) === index,
        )}
        sizes="(min-width: 48rem) 50vw, 100vw"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <span class="home-hero__glint" data-reveal="hero" aria-hidden="true"></span>
    </figure>
  )}
</section>

<ServiceHighlights lang={lang} />

<section class="section home-products" aria-labelledby="home-products-title">
  <div class="wrap">
    <div class="home-section-heading" data-reveal="rise">
      <h2 class="section-title" id="home-products-title">
        {settings[`products_title_${lang}`]}
      </h2>
      <p class="muted">{settings[`products_text_${lang}`]}</p>
    </div>
    <div class="home-product-grid">
      {featured.map(({ service, photo }) => (
        <a
          class="home-product"
          data-reveal="rise"
          href={url(service.slug)}
          aria-labelledby={`home-${service.slug}`}
        >
          {photo && (
            <span class="home-product__media">
              <Picture
                src={photo.image}
                alt={photo[`alt_${lang}`]}
                formats={['avif', 'webp']}
                widths={[280, 480, 640].filter((width) => width <= photo.image.width)}
                sizes="(min-width: 70rem) 18rem, (min-width: 48rem) 23vw, 46vw"
                loading="lazy"
                decoding="async"
              />
            </span>
          )}
          <h3 id={`home-${service.slug}`}>
            {service[`title_${lang}`]} <Icon name="arrow-right" />
          </h3>
        </a>
      ))}
    </div>
    <ul class="home-other-products" data-reveal="rise">
      {otherServices.map((service) => (
        <li>
          <a href={url(service.slug)}>
            <span class="home-other-products__glyph">
              <ProductIcon slug={service.slug} reveal />
            </span>
            <span class="home-other-products__title">{service[`title_${lang}`]}</span>
            <Icon name="arrow-right" />
          </a>
        </li>
      ))}
    </ul>
    <a class="text-link home-all-products" href={url('products')}>
      <span>{labels.products}</span>
      <Icon name="arrow-right" />
    </a>
  </div>
</section>

<CompanyMetrics lang={lang} />

<div class="home-band">
  <Gallery lang={lang} compact />
  <Reputation lang={lang} />
</div>

<section class="section home-company" aria-labelledby="home-about-title">
  <div class="wrap">
    <div class="home-company__grid">
      <div data-reveal="rise">
        <h2 class="section-title" id="home-about-title">
          {about[`title_${lang}`]}
        </h2>
        <p class="lead">{about[`lead_${lang}`]}</p>
        <details class="home-about-details">
          <summary>
            {labels.about} <Icon name="chevron-down" />
          </summary>
          {paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </details>
      </div>
      <div class="home-process" data-reveal="rise">
        <h2 class="section-title">{labels.process}</h2>
        <ol class="home-steps" data-reveal="line">
          {labels.steps.map((step) => (
            <li>{step}</li>
          ))}
        </ol>
        <p>{settings[`process_${lang}`]}</p>
        <a class="text-link" href={url('services')}>
          {labels.services} <Icon name="arrow-right" />
        </a>
      </div>
    </div>
    <div class="home-offers">
      <article data-reveal="rise">
        <h3>{about[`special_glass_title_${lang}`]}</h3>
        <p>{about[`special_glass_text_${lang}`]}</p>
      </article>
      <article data-reveal="rise">
        <h3>{about[`consultation_title_${lang}`]}</h3>
        <p>{about[`consultation_text_${lang}`]}</p>
      </article>
    </div>
    <a class="button" href={url('contact')}>
      {labels.enquiry}
    </a>
  </div>
</section>

<Contact lang={lang} compact />

<style>
  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: stretch;
    min-height: 34rem;
    min-height: min(34rem, 68svh);
  }

  .home-hero__copy {
    align-self: center;
    /* Percent padding uses the half-width grid cell: 620px is half of .wrap's 1240px. */
    padding: clamp(2.5rem, 4vw, 4rem) clamp(1.5rem, 4vw, 4rem) clamp(2.5rem, 4vw, 4rem)
      max(1.5rem, calc(100% - 620px));
  }

  /* Copy enters once on first document load; the hero photo stays eager and unanimated. */
  @media (prefers-reduced-motion: no-preference) {
    .home-hero__copy > * {
      animation: home-hero-in 640ms var(--ease) backwards;
    }

    .home-hero__copy > :nth-child(2) {
      animation-delay: 70ms;
    }

    .home-hero__copy > :nth-child(3) {
      animation-delay: 140ms;
    }

    .home-hero__copy > :nth-child(4) {
      animation-delay: 210ms;
    }
  }

  @keyframes home-hero-in {
    from {
      opacity: 0.6;
      transform: translateY(12px);
      filter: blur(6px);
    }
  }

  .home-hero h1 {
    max-width: 13ch;
    margin: 0 0 1.5rem;
    font-size: clamp(2.75rem, 4.7vw, 4.6rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
    text-wrap: balance;
    overflow-wrap: normal;
  }

  .home-hero .lead {
    max-width: 38ch;
  }

  .home-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .home-call {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.6rem;
    margin-top: 1.5rem;
  }

  .home-call .text-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .home-hero__media {
    min-width: 0;
    margin: 0;
  }

  .home-hero__media :global(picture) {
    display: block;
    height: 100%;
  }

  .home-hero__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% center;
  }

  .home-section-heading {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: start;
    margin-bottom: 2rem;
  }

  .home-section-heading p {
    max-width: 48ch;
    margin-top: 0;
    justify-self: end;
  }

  .home-product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem 1.5rem;
  }

  .home-product {
    position: relative;
    display: block;
    color: inherit;
    text-decoration: none;
  }

  /* The frame keeps its layout size. The photo grows past it by the bleed, clipped to the frame. */
  .home-product__media {
    position: relative;
    display: block;
    aspect-ratio: 3 / 2;
    transition: filter var(--dur-bleed) var(--ease);
  }

  .home-product__media :global(picture) {
    position: absolute;
    inset: calc(var(--bleed-y) * -1) calc(var(--bleed-x) * -1);
    clip-path: inset(var(--bleed-y) var(--bleed-x));
    transition: clip-path var(--dur-bleed) var(--ease);
  }

  .home-product__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-product:focus-visible,
  .home-product:hover {
    z-index: 1;
  }

  .home-product:focus-visible .home-product__media :global(picture) {
    clip-path: inset(0);
  }

  .home-product:focus-visible .home-product__media {
    filter: drop-shadow(0 16px 24px rgb(7 30 40 / 0.18));
  }

  .home-product h3 {
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.4;
    text-wrap: balance;
  }

  .home-product__media + h3 {
    margin-top: calc(var(--bleed-y) + 0.5rem);
  }

  @media (hover: hover) and (pointer: fine) {
    .home-product:hover .home-product__media :global(picture) {
      clip-path: inset(0);
    }

    .home-product:hover .home-product__media {
      filter: drop-shadow(0 16px 24px rgb(7 30 40 / 0.18));
    }
  }

  .home-product:focus-visible {
    outline: 3px solid var(--accent, #087fa0);
    outline-offset: 5px;
  }

  .home-band {
    background: var(--surface);
  }

  .home-all-products {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    margin-top: 1rem;
  }

  .home-other-products {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin: 2rem 0 0;
    padding: 2rem 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .home-other-products a {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    height: 100%;
    min-height: 4.5rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: inset 1px 1px 0 var(--glass-edge);
    color: var(--text);
    font-weight: 600;
    line-height: 1.3;
    text-decoration: none;
    transition:
      border-color var(--dur-bleed) var(--ease),
      box-shadow var(--dur-bleed) var(--ease),
      color var(--dur-fast) var(--ease),
      translate var(--dur-bleed) var(--ease);
  }

  .home-other-products__title {
    flex: 1;
  }

  .home-other-products__glyph {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--line));
    border-radius: 50%;
    background: var(--glass-solid);
    color: var(--accent);
    font-size: 1.05rem;
    transition:
      background-color var(--dur-bleed) var(--ease),
      border-color var(--dur-bleed) var(--ease),
      color var(--dur-bleed) var(--ease);
  }

  .home-other-products a :global([data-icon='arrow-right']) {
    color: var(--accent);
  }

  .home-other-products a:focus-visible .home-other-products__glyph {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--on-accent);
  }

  @media (hover: hover) and (pointer: fine) {
    .home-other-products a:hover {
      border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
      box-shadow:
        inset 1px 1px 0 var(--glass-edge),
        var(--lift);
      color: var(--accent);
      translate: 0 -3px;
    }

    .home-other-products a:hover .home-other-products__glyph {
      border-color: var(--accent);
      background: var(--accent);
      color: var(--on-accent);
    }
  }

  /* A single light pass over the hero photo on first load; the photo itself never animates. */
  .home-hero__media {
    position: relative;
    overflow: hidden;
  }

  .home-hero__glint {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 35%,
      rgb(255 255 255 / 0.32) 50%,
      transparent 65%
    );
    pointer-events: none;
    transform: translateX(100%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .home-hero__glint {
      animation: home-hero-glint 1400ms var(--ease) 450ms backwards;
    }
  }

  @keyframes home-hero-glint {
    from {
      transform: translateX(-100%);
    }
  }

  .home-about-details {
    margin-top: 1rem;
  }

  .home-about-details summary {
    width: fit-content;
    padding-block: 0.5rem;
    color: var(--accent);
    cursor: pointer;
  }

  .home-about-details p {
    margin-top: 1rem;
  }

  .home-company__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 7vw, 7rem);
  }

  .home-company__grid p {
    max-width: 65ch;
  }

  .home-process {
    border-left: 1px solid var(--line, #cedfe5);
    padding-left: clamp(1.5rem, 3vw, 3rem);
  }

  .home-steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 0.75rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .home-steps li {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    counter-increment: step;
  }

  /* Circles sit above the connector, so they need the company section background. */
  .home-steps li::before {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--accent, #087fa0);
    border-radius: 50%;
    background: var(--bg);
    content: counter(step);
    color: var(--accent, #087fa0);
    font-weight: 600;
  }

  .home-process .text-link {
    display: inline-block;
    margin-top: 1rem;
  }

  .home-offers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 3rem);
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .home-offers h3 {
    margin-bottom: 0.75rem;
    font-size: var(--step-1);
    line-height: 1.3;
  }

  .home-offers p {
    color: var(--muted);
  }

  .home-offers + .button {
    margin-top: 2rem;
  }

  @media (min-width: 80rem) {
    .home-steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    /* Four columns: the connector runs from the first circle centre to the last. */
    .home-steps::before {
      position: absolute;
      top: 1.375rem;
      left: 1.375rem;
      right: calc((100% - 2.25rem) / 4 - 1.375rem);
      height: 1px;
      background: var(--line);
      content: '';
      transform-origin: left center;
    }
  }

  @media (max-width: 47.99rem) {
    .home-hero,
    .home-section-heading,
    .home-company__grid,
    .home-offers {
      grid-template-columns: minmax(0, 1fr);
    }

    .home-hero {
      min-height: 0;
    }

    .home-hero__copy {
      padding: 3rem 1.5rem;
    }

    .home-hero h1 {
      max-width: 17ch;
      font-size: clamp(2.25rem, 9vw, 3rem);
    }

    .home-hero__media :global(picture) {
      height: auto;
    }

    .home-hero__media :global(img) {
      height: auto;
      aspect-ratio: 4 / 3;
    }

    .home-section-heading {
      gap: 0.75rem;
    }

    .home-section-heading p {
      justify-self: start;
    }

    .home-product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem 1rem;
    }

    .home-process {
      border-left: 0;
      border-top: 1px solid var(--line, #cedfe5);
      padding: 2rem 0 0;
    }
  }

  @media (max-width: 640px) {
    .home-hero__copy {
      padding-inline: 1rem;
    }
  }

  @media (max-width: 63.99rem) {
    .home-other-products {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 29.99rem) {
    .home-other-products {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-other-products a:hover {
      translate: none;
    }
  }
</style>
