// Multi-part icons keep each stroke separate, so their parts can animate.
const paths = {
  phone:
    'M8 3H4a1 1 0 0 0-1 1c0 9.4 7.6 17 17 17a1 1 0 0 0 1-1v-4l-5-2-2 3a15 15 0 0 1-7-7l3-2-2-5Z',
  mail: ['M3 5h18v14H3Z', 'M3 6l9 7 9-7'],
  copy: ['M9 9h12v12H9Z', 'M15 9V3H3v12h6'],
  send: 'm3 3 18 9-18 9 4-9-4-9Z M7 12h14',
  location: 'M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z M15 10a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z',
  clock: 'M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z M12 6v6l4 2',
  image: [
    'M3 4.5h18v15H3Z',
    'M17.5 8a1 1 0 1 1-2 0 1 1 0 0 1 2 0Z',
    'm3 16 6-6 9.5 9.5 M14 15l3-3 4 4',
  ],
  facebook:
    'M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0-.002 3.603-.002 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.009c-.993 0-1.303.621-1.303 1.258v1.51h2.218l-.354 2.326H9.25V16c3.824-.604 6.75-3.934 6.75-7.951',
  'arrow-right': ['M4.5 12h13', 'm12.5 6.5 5.5 5.5-5.5 5.5'],
  'arrow-left': ['M19.5 12h-13', 'm11.5 6.5-5.5 5.5 5.5 5.5'],
  'chevron-down': ['m6.5 9.5 5.5 5.5 5.5-5.5'],
  close: ['m6.5 6.5 11 11', 'm17.5 6.5-11 11'],
  flip: [
    'M4.5 10.5a7.5 7.5 0 0 1 13.4-3.6',
    'M18.5 3.5v4h-4',
    'M19.5 13.5a7.5 7.5 0 0 1-13.4 3.6',
    'M5.5 20.5v-4h4',
  ],
  menu: ['M4 7h16', 'M4 12h16', 'M4 17h16'],
  external: [
    'M13.5 4.5h6v6',
    'm19.5 4.5-8 8',
    'M17.5 14v4.5a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1v-11a1 1 0 0 1 1-1H10',
  ],
} as const satisfies Record<string, string | readonly string[]>;

export type IconName = keyof typeof paths;

interface Props {
  name: IconName;
}

const { name } = Astro.props;
const shape = paths[name];
const parts: readonly string[] = typeof shape === 'string' ? [shape] : shape;
---

<svg
  width="20"
  height="20"
  viewBox={name === 'facebook' ? '0 0 16 16' : '0 0 24 24'}
  fill={name === 'facebook' ? 'currentColor' : 'none'}
  stroke={name === 'facebook' ? 'none' : 'currentColor'}
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  data-icon={name}
>
  {parts.map((d) => (
    <path d={d} />
  ))}
</svg>

<style>
  svg {
    display: inline-block;
    width: 1.1em;
    height: 1.1em;
    flex: none;
    overflow: visible;
    vertical-align: -0.18em;
  }

  /* Motion answers the control that owns the icon: hover, keyboard focus, open or pressed. */
  path {
    transform-box: fill-box;
    transition:
      transform var(--dur-fast, 160ms) var(--ease, cubic-bezier(0.2, 0.7, 0.2, 1)),
      opacity var(--dur-fast, 160ms) var(--ease, cubic-bezier(0.2, 0.7, 0.2, 1)),
      d var(--dur-fast, 160ms) var(--ease, cubic-bezier(0.2, 0.7, 0.2, 1));
  }

  [data-icon='arrow-right'] path:first-child {
    transform-origin: left center;
  }

  [data-icon='arrow-left'] path:first-child {
    transform-origin: right center;
  }

  :global(:is(a, button, summary):focus-visible) [data-icon='arrow-right'] path:first-child {
    transform: scaleX(1.25);
  }

  :global(:is(a, button, summary):focus-visible) [data-icon='arrow-right'] path:last-child {
    transform: translateX(3px);
  }

  :global(:is(a, button, summary):focus-visible) [data-icon='arrow-left'] path:first-child {
    transform: scaleX(1.25);
  }

  :global(:is(a, button, summary):focus-visible) [data-icon='arrow-left'] path:last-child {
    transform: translateX(-3px);
  }

  @media (hover: hover) and (pointer: fine) {
    :global(:is(a, button, summary):hover) [data-icon='arrow-right'] path:first-child {
      transform: scaleX(1.25);
    }

    :global(:is(a, button, summary):hover) [data-icon='arrow-right'] path:last-child {
      transform: translateX(3px);
    }

    :global(:is(a, button, summary):hover) [data-icon='arrow-left'] path:first-child {
      transform: scaleX(1.25);
    }

    :global(:is(a, button, summary):hover) [data-icon='arrow-left'] path:last-child {
      transform: translateX(-3px);
    }

    :global(button:hover) [data-icon='flip'] {
      transform: rotate(180deg);
    }
  }

  [data-icon='flip'],
  [data-icon='chevron-down'] {
    transition: transform var(--dur-flip, 620ms) var(--ease, cubic-bezier(0.2, 0.7, 0.2, 1));
  }

  [data-icon='chevron-down'] {
    transition-duration: 280ms;
  }

  :global(:is([aria-expanded='true'], details[open] > summary)) [data-icon='chevron-down'] {
    transform: rotate(180deg);
  }

  [data-icon='menu'] path {
    transform-origin: center;
    transition-duration: 280ms;
  }

  :global(:is([aria-expanded='true'], details[open] > summary))
    [data-icon='menu']
    path:nth-child(1) {
    transform: translateY(5px) rotate(45deg);
  }

  :global(:is([aria-expanded='true'], details[open] > summary))
    [data-icon='menu']
    path:nth-child(2) {
    opacity: 0;
    transform: scaleX(0.2);
  }

  :global(:is([aria-expanded='true'], details[open] > summary))
    [data-icon='menu']
    path:nth-child(3) {
    transform: translateY(-5px) rotate(-45deg);
  }

  /* Contact icons answer their control while the icon box stays put: the envelope flap lifts, the
     copied sheet fans out, the external arrow leaves its box and the paper plane noses up. Strokes
     keep their width, and every change is a transition, so a quick pass reverses smoothly. */
  [data-icon='send'] path {
    transform-origin: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(:is(a, button):focus-visible) [data-icon='image'] path:nth-child(2) {
      transform: translateY(-1px);
    }

    :global(:is(a, button):focus-visible) [data-icon='mail'] path:last-child {
      d: path('M3 6l9 3.5 9-3.5');
    }

    :global(:is(a, button):focus-visible) [data-icon='copy'] path:last-child {
      d: path('M13 9V1H1v12h8');
    }

    :global(:is(a, button):focus-visible) [data-icon='external'] path:not(:last-child) {
      transform: translate(1.5px, -1.5px);
    }

    :global(button:focus-visible) [data-icon='send'] path {
      transform: rotate(-12deg);
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    :global(:is(a, button):hover) [data-icon='image'] path:nth-child(2) {
      transform: translateY(-1px);
    }

    :global(:is(a, button):hover) [data-icon='mail'] path:last-child {
      d: path('M3 6l9 3.5 9-3.5');
    }

    :global(:is(a, button):hover) [data-icon='copy'] path:last-child {
      d: path('M13 9V1H1v12h8');
    }

    :global(:is(a, button):hover) [data-icon='external'] path:not(:last-child) {
      transform: translate(1.5px, -1.5px);
    }

    :global(button:not(:disabled):hover) [data-icon='send'] path {
      transform: rotate(-12deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    svg,
    path {
      transition: none;
    }
  }
</style>
