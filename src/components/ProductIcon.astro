---
import type { ServiceSlug } from '../lib/urls';

// Decorative line pictograms, one per established product route.
const paths: Record<ServiceSlug, readonly string[]> = {
  'sklenene-dvere': ['M6.5 3.5h11v17h-11Z', 'M14.5 10.5v3', 'm9.5 9 2.5-2.5', 'm9.5 12.5 4.5-4.5'],
  'sklenene-zabradli': [
    'M3.5 20.5h17',
    'M3.5 7.5h17',
    'M6 7.5v13',
    'M18 7.5v13',
    'M8.5 10h7v8h-7Z',
  ],
  'skleneny-sprchovy-kout': [
    'M4.5 20.5h15',
    'M6.5 20.5v-14a3 3 0 0 1 3-3h5a3 3 0 0 1 3 3v14',
    'M12 6.5v14',
    'M9 11v1.5',
    'M9 15v1.5',
    'M15 13v1.5',
  ],
  'sklenena-stena': [
    'M3.5 4.5h17v15h-17Z',
    'M9.2 4.5v15',
    'M14.8 4.5v15',
    'm5.5 9 2-2',
    'm11 10 2.5-2.5',
  ],
  'skleneny-obklad-do-kuchyne': [
    'M4.5 3.5h15v4h-15Z',
    'M4.5 9.5h15v4.5h-15Z',
    'M3 16.5h18',
    'M5 16.5v4',
    'M19 16.5v4',
    'm7 12.5 2.5-2.5',
  ],
  'sklenene-strisky-zaskleni-pergol-zastreseni': [
    'M3 5.5 21 8.5v2L3 7.5Z',
    'M5.5 7.9v12.6',
    'M18.5 10.1v10.4',
    'M3 20.5h18',
  ],
  'sklenene-dekorace-gravirovani-fotek': [
    'M4.5 4.5h15v15h-15Z',
    'm4.5 16 4.5-4.5 3.5 3.5 2.5-2.5 4.5 4.5',
    'M15.5 8.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z',
  ],
  'sklenene-nahrobni-desky': [
    'M7 20.5V9a5 5 0 0 1 10 0v11.5',
    'M4.5 20.5h15',
    'M10 11.5h4',
    'M10 14.5h4',
  ],
};

interface Props {
  slug: ServiceSlug;
  /** Draw the strokes in when the icon scrolls into view. */
  reveal?: boolean;
}

const { slug, reveal = false } = Astro.props;
---

<svg
  class="product-icon"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  data-reveal={reveal ? 'draw' : undefined}
>
  {paths[slug].map((d) => (
    <path d={d} pathLength="1" />
  ))}
</svg>

<style>
  .product-icon {
    display: block;
    width: 1.5em;
    height: 1.5em;
    flex: none;
    overflow: visible;
  }

  /* Scroll reveals draw the strokes (motion.ts). Hover only recolours the surrounding glyph,
     so a quick pass never blanks or snaps the pictogram. */
  path {
    stroke-dasharray: 1;
  }
</style>
