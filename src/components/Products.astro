---
import { Picture } from 'astro:assets';
import { getGallery, getServices, getSettings } from '../content';
import { pageUrl, type Language } from '../lib/urls';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const [settings, services, gallery] = await Promise.all([
  getSettings(),
  getServices(),
  getGallery(),
]);
const url = (page: Parameters<typeof pageUrl>[0]) => pageUrl(page, lang, import.meta.env.BASE_URL);
const labels = {
  cs: { detail: 'Detail', enquiry: 'Nezávazná poptávka', process: 'Jak probíhá zakázka' },
  en: {
    detail: 'Details',
    enquiry: 'Project enquiry',
    process: 'How your project takes shape',
  },
}[lang];
---

<section class="section" aria-labelledby="products-title">
  <div class="wrap">
    <header class="products-heading">
      <h1 id="products-title">{settings[`products_title_${lang}`]}</h1>
      <p class="lead">{settings[`products_text_${lang}`]}</p>
    </header>
    <div class="products-grid">
      {services.map((service) => {
        const photo = gallery.find((item) => item.category === service.slug);
        return (
          <article class="product">
            {photo && (
              <Picture
                src={photo.image}
                alt={photo[`alt_${lang}`]}
                formats={['avif', 'webp']}
                widths={[360, 600, 900].filter((width) => width <= photo.image.width)}
                sizes="(min-width: 70rem) 37rem, (min-width: 40rem) 46vw, 100vw"
                loading="lazy"
                decoding="async"
              />
            )}
            <h2 class:list={['product__title', { 'product__title--panel': !photo }]}>
              <a class="text-link" href={url(service.slug)}>
                {service[`title_${lang}`]}
              </a>
            </h2>
            <p>{service[`text_${lang}`]}</p>
            <a
              class="text-link product__detail"
              href={url(service.slug)}
              aria-label={`${labels.detail}: ${service[`title_${lang}`]}`}
            >
              {labels.detail}
              <span aria-hidden="true">→</span>
            </a>
          </article>
        );
      })}
    </div>
  </div>
</section>

<section class="section products-process" aria-labelledby="products-process-title">
  <div class="wrap products-process__layout">
    <h2 class="section-title" id="products-process-title">
      {labels.process}
    </h2>
    <div>
      <p>{settings[`process_${lang}`]}</p>
      <a class="button" href={url('contact')}>
        {labels.enquiry}
      </a>
    </div>
  </div>
</section>

<style>
  .products-heading {
    max-width: 52rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .products-heading h1 {
    margin: 0 0 1.25rem;
    font-size: clamp(2.4rem, 5vw, 4.3rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 5vw, 4.5rem) 2rem;
  }

  .product {
    min-width: 0;
  }

  .product :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .product__title {
    margin: 1.25rem 0 0.75rem;
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    line-height: 1.25;
    text-wrap: balance;
  }

  /* Title panel takes the photo slot for products without a photo. */
  .product__title--panel {
    display: grid;
    align-content: end;
    aspect-ratio: 3 / 2;
    margin: 0;
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--surface, #edf7fa);
    font-size: clamp(1.875rem, 1.3rem + 2.2vw, 2.875rem);
    line-height: 1.15;
  }

  .product p {
    max-width: 65ch;
    margin: 0;
    color: var(--muted, #52666f);
  }

  .product__detail {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
    margin-top: 0.5rem;
  }

  .product__detail span {
    display: inline-block;
    transition: transform 160ms ease;
  }

  .product__detail:hover span {
    transform: translateX(3px);
  }

  .products-process {
    background: var(--surface, #edf7fa);
  }

  .products-process__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem;
  }

  .products-process p {
    max-width: 62ch;
    margin-top: 0;
    margin-bottom: 1.5rem;
  }

  @media (max-width: 39.99rem) {
    .products-grid,
    .products-process__layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .products-process__layout {
      gap: 1rem;
    }
  }
</style>
