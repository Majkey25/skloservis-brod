---
import { Picture } from 'astro:assets';
import { getGallery, getServices, getSettings } from '../content';
import { pageUrl, type Language } from '../lib/urls';
import FlipCard from './FlipCard.astro';
import Icon from './Icon.astro';
import ProductIcon from './ProductIcon.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const [settings, services, gallery] = await Promise.all([
  getSettings(),
  getServices(),
  getGallery(),
]);
const url = (page: Parameters<typeof pageUrl>[0]) => pageUrl(page, lang, import.meta.env.BASE_URL);
const labels = {
  cs: {
    detail: 'Detail',
    enquiry: 'Nezávazná poptávka',
    process: 'Jak probíhá zakázka',
    more: 'Podrobnosti',
    back: 'Zpět',
  },
  en: {
    detail: 'Details',
    enquiry: 'Project enquiry',
    process: 'How your project takes shape',
    more: 'Details',
    back: 'Back',
  },
}[lang];
---

<section class="section" aria-labelledby="products-title">
  <div class="wrap">
    <header class="products-heading" data-reveal="rise">
      <h1 id="products-title">{settings[`products_title_${lang}`]}</h1>
      <p class="lead">{settings[`products_text_${lang}`]}</p>
    </header>
    <div class="products-grid">
      {services.map((service, index) => {
        const photo = gallery.find((item) => item.category === service.slug);
        const title = service[`title_${lang}`];
        return (
          <article class="product" data-reveal="rise">
            <FlipCard
              id={`product-${service.slug}`}
              openLabel={`${labels.more}: ${title}`}
              toggleLabel={labels.more}
              closeLabel={labels.back}
              hoverDelay={320}
            >
              <Fragment slot="front">
                {!photo && (
                  <span class="product__glyph" aria-hidden="true">
                    <ProductIcon slug={service.slug} reveal />
                  </span>
                )}
                {photo && (
                  <span class="product__media">
                    <Picture
                      src={photo.image}
                      alt={photo[`alt_${lang}`]}
                      formats={['avif', 'webp']}
                      widths={[
                        ...new Set(
                          [320, 480, Math.min(720, photo.image.width)].filter(
                            (width) => width <= photo.image.width,
                          ),
                        ),
                      ]}
                      sizes="(min-width: 70rem) 24rem, (min-width: 60rem) 30vw, (min-width: 40rem) 46vw, 100vw"
                      loading={index === 0 ? 'eager' : 'lazy'}
                      fetchpriority={index === 0 ? 'high' : undefined}
                      decoding="async"
                    />
                  </span>
                )}
                <h2 class:list={['product__title', { 'product__title--plain': !photo }]}>
                  <a class="text-link" href={url(service.slug)}>
                    {title}
                  </a>
                </h2>
                <p>{service[`seo_description_${lang}`]}</p>
              </Fragment>
              <Fragment slot="back">
                <p>{service[`text_${lang}`]}</p>
                <a
                  class="text-link product__detail"
                  href={url(service.slug)}
                  aria-label={`${labels.detail}: ${title}`}
                >
                  {labels.detail} <Icon name="arrow-right" />
                </a>
                <a class="text-link product__enquiry" href={url('contact')}>
                  {labels.enquiry}
                </a>
              </Fragment>
            </FlipCard>
          </article>
        );
      })}
    </div>
  </div>
</section>

<section class="section products-process" aria-labelledby="products-process-title">
  <div class="wrap products-process__layout">
    <h2 class="section-title" id="products-process-title">
      {labels.process}
    </h2>
    <div>
      <p>{settings[`process_${lang}`]}</p>
      <a class="button" href={url('contact')}>
        {labels.enquiry}
      </a>
    </div>
  </div>
</section>

<style>
  .products-heading {
    max-width: 52rem;
    margin-bottom: 2rem;
  }

  .products-heading h1 {
    margin: 0 0 1.25rem;
    font-size: clamp(2.4rem, 5vw, 4.3rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1.5rem;
  }

  .product {
    min-width: 0;
  }

  /* The frame keeps its layout size. The photo grows into the card padding by the bleed. */
  .product__media {
    position: relative;
    display: block;
    aspect-ratio: 3 / 2;
  }

  .product__media :global(picture) {
    position: absolute;
    inset: calc(var(--bleed-y) * -1) calc(var(--bleed-x) * -1);
    clip-path: inset(var(--bleed-y) var(--bleed-x));
    transition: clip-path var(--dur-bleed) var(--ease);
  }

  .product__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product:has(:focus-visible) .product__media :global(picture) {
    clip-path: inset(0);
  }

  .product__title {
    margin: 1rem 0 0.5rem;
    font-size: clamp(1.2rem, 1.7vw, 1.5rem);
    line-height: 1.25;
    text-wrap: balance;
  }

  .product__media + .product__title {
    margin-top: calc(var(--bleed-y) + 0.5rem);
  }

  /* Without a photo the title starts at the pane top, clear of the flip toggle. */
  .product__title--plain {
    margin: 0 0 0.5rem;
    padding-right: 3.5rem;
  }

  .product__glyph {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    margin-bottom: 1.25rem;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--line));
    border-radius: 50%;
    background: var(--glass-solid);
    box-shadow: inset 1px 1px 0 var(--glass-edge);
    color: var(--accent);
    font-size: 1.35rem;
  }

  .product p {
    max-width: 65ch;
    margin: 0;
    color: var(--muted, #52666f);
  }

  .product__detail,
  .product__enquiry {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    min-height: 44px;
  }

  .product__detail {
    gap: 0.35rem;
    margin-top: 0.5rem;
  }

  .products-process {
    background: var(--surface, #edf7fa);
  }

  .products-process__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem;
  }

  .products-process p {
    max-width: 62ch;
    margin-top: 0;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 60rem) {
    .products-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .product:hover .product__media :global(picture) {
      clip-path: inset(0);
    }
  }

  @media (max-width: 39.99rem) {
    .products-grid,
    .products-process__layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .products-process__layout {
      gap: 1rem;
    }
  }
</style>
