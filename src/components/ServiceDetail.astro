---
import { Picture } from 'astro:assets';
import { getContact, getGallery, getServices, getSettings } from '../content';
import { pageUrl, type Language, type ServiceSlug } from '../lib/urls';

interface Props {
  lang: Language;
  slug: ServiceSlug;
}

const { lang, slug } = Astro.props;
const [settings, services, gallery, contact] = await Promise.all([
  getSettings(),
  getServices(),
  getGallery(),
  getContact(),
]);
const service = services.find((item) => item.slug === slug);
if (!service) throw new Error(`Missing validated service: ${slug}`);
const photos = gallery.filter((item) => item.category === slug);
const hero = photos[0];
const additionalPhotos = photos.slice(1, 4);
const url = (page: Parameters<typeof pageUrl>[0]) => pageUrl(page, lang, import.meta.env.BASE_URL);
const labels = {
  cs: {
    products: 'Produkty',
    enquiry: 'Poptat tento výrobek',
    prepare: 'Co uvést do poptávky',
    process: 'Od představy k realizaci',
    examples: 'Ukázky provedení',
    gallery: 'Celá galerie',
    related: 'Další skleněné výrobky',
    contact: 'Probrat zadání',
  },
  en: {
    products: 'Products',
    enquiry: 'Enquire about this product',
    prepare: 'What to include in your enquiry',
    process: 'From your idea to the finished project',
    examples: 'Examples of our work',
    gallery: 'Full gallery',
    related: 'More glass products',
    contact: 'Discuss your requirements',
  },
}[lang];
// Enquiry prompts ask for project information; they make no technical promises.
const prompts: Record<ServiceSlug, { cs: string[]; en: string[] }> = {
  'sklenene-dvere': {
    cs: [
      'Rozměry otvoru a místo realizace',
      'Představa o otevírání dveří',
      'Požadované provedení skla',
    ],
    en: [
      'Opening dimensions and project location',
      'Preferred door opening arrangement',
      'Preferred glass finish',
    ],
  },
  'sklenene-zabradli': {
    cs: [
      'Místo použití a přibližné rozměry',
      'Fotografie schodiště, balkonu nebo terasy',
      'Představa o vzhledu a uchycení',
    ],
    en: [
      'Location and approximate dimensions',
      'Photos of the staircase, balcony or terrace',
      'Ideas for the appearance and fixings',
    ],
  },
  'skleneny-sprchovy-kout': {
    cs: [
      'Přibližné rozměry a dispozice koupelny',
      'Představa o dveřích nebo zástěně',
      'Fotografie místa pro sprchový kout',
    ],
    en: [
      'Approximate dimensions and bathroom layout',
      'Ideas for the doors or shower screen',
      'Photos of the shower area',
    ],
  },
  'sklenena-stena': {
    cs: [
      'Rozměry a místo plánované příčky',
      'Požadavek na dveře',
      'Představa o čirém, matovaném či dekorovaném skle',
    ],
    en: [
      'Dimensions and location of the planned partition',
      'Whether a door is required',
      'Preference for clear, frosted or decorated glass',
    ],
  },
  'skleneny-obklad-do-kuchyne': {
    cs: [
      'Přibližné rozměry obkladu',
      'Představa o barvě a potřebných otvorech',
      'Fotografie kuchyňské linky',
    ],
    en: [
      'Approximate splashback dimensions',
      'Colour preference and required cut-outs',
      'Photos of the kitchen units and worktop',
    ],
  },
  'sklenene-strisky-zaskleni-pergol-zastreseni': {
    cs: [
      'Místo a přibližné rozměry zastřešení či zasklení',
      'Fotografie stávající konstrukce',
      'Představa o pevných či posuvných panelech',
    ],
    en: [
      'Location and approximate roofing or glazing dimensions',
      'Photos of the existing structure',
      'Preference for fixed or sliding panels',
    ],
  },
  'sklenene-dekorace-gravirovani-fotek': {
    cs: [
      'Druh dekorace a přibližné rozměry',
      'Text nebo představa o fotografii k gravírování',
      'Požadované provedení',
    ],
    en: [
      'Type of decoration and approximate dimensions',
      'Wording or an idea for the photograph to engrave',
      'Preferred design',
    ],
  },
  'sklenene-nahrobni-desky': {
    cs: ['Požadované rozměry desky', 'Přesné znění nápisu', 'Zda má být součástí fotografie'],
    en: [
      'Requested plaque dimensions',
      'Exact inscription wording',
      'Whether a photograph should be included',
    ],
  },
};
const isEngraved =
  slug === 'sklenene-dekorace-gravirovani-fotek' || slug === 'sklenene-nahrobni-desky';
const related = services.filter((item) => item.slug !== slug);
---

<section class="section" aria-labelledby="service-title">
  <div class="wrap">
    <nav
      class="service-breadcrumb"
      aria-label={lang === 'cs' ? 'Drobečková navigace' : 'Breadcrumb'}
    >
      <a class="text-link" href={url('products')}>
        {labels.products}
      </a>
    </nav>
    <div class:list={['service-hero', { 'service-hero--text': !hero }]}>
      <div class="service-hero__copy">
        <h1 id="service-title">{service[`title_${lang}`]}</h1>
        <p class="lead">{service[`text_${lang}`]}</p>
        <a class="button" href={url('contact')}>
          {labels.enquiry}
        </a>
      </div>
      {hero && (
        <figure class="service-hero__media">
          <Picture
            src={hero.image}
            alt={hero[`alt_${lang}`]}
            formats={['avif', 'webp']}
            widths={[360, 600, 900, Math.min(1200, hero.image.width)].filter(
              (width, index, all) => width <= hero.image.width && all.indexOf(width) === index,
            )}
            sizes="(min-width: 70rem) 37rem, (min-width: 48rem) 46vw, 100vw"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      )}
    </div>
  </div>
</section>

<section class="section service-planning" aria-labelledby="service-planning-title">
  <div class="wrap service-planning__grid">
    <div>
      <h2 class="section-title" id="service-planning-title">
        {isEngraved ? contact[`enquiry_title_${lang}`] : labels.process}
      </h2>
      <p>{isEngraved ? contact[`enquiry_text_${lang}`] : settings[`process_${lang}`]}</p>
      <a class="text-link" href={url('contact')}>
        {labels.contact}
      </a>
    </div>
    <div class="service-prompts">
      <h2>{labels.prepare}</h2>
      <ul>
        {prompts[slug][lang].map((prompt) => (
          <li>{prompt}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

{additionalPhotos.length > 0 && (
  <section class="section" aria-labelledby="service-examples-title">
    <div class="wrap">
      <div class="service-section-heading">
        <h2 class="section-title" id="service-examples-title">
          {labels.examples}
        </h2>
        <a class="text-link" href={url('gallery')}>
          {labels.gallery}
        </a>
      </div>
      <div class="service-photos">
        {additionalPhotos.map((photo) => (
          <figure>
            <Picture
              src={photo.image}
              alt={photo[`alt_${lang}`]}
              formats={['avif', 'webp']}
              widths={[320, 540, 800].filter((width) => width <= photo.image.width)}
              sizes="(min-width: 70rem) 25rem, (min-width: 48rem) 30vw, (min-width: 32rem) 46vw, 100vw"
              loading="lazy"
              decoding="async"
            />
            <figcaption>{photo[`caption_${lang}`] ?? photo[`alt_${lang}`]}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}

<section class="section service-related" aria-labelledby="service-related-title">
  <div class="wrap">
    <h2 class="section-title" id="service-related-title">
      {labels.related}
    </h2>
    <ul class="service-related__links">
      {related.map((item) => (
        <li>
          <a class="text-link" href={url(item.slug)}>
            {item[`title_${lang}`]}
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .service-breadcrumb {
    margin-bottom: 2rem;
  }

  .service-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .service-hero--text {
    grid-template-columns: minmax(0, 50rem);
  }

  .service-hero h1 {
    margin: 0 0 1.5rem;
    font-size: clamp(2.4rem, 4.5vw, 4.1rem);
    letter-spacing: -0.04em;
    line-height: 1.1;
    text-wrap: balance;
  }

  .service-hero .lead {
    max-width: 60ch;
    margin-bottom: 2rem;
  }

  .service-hero__media,
  .service-photos figure {
    min-width: 0;
    margin: 0;
  }

  .service-hero__media :global(img) {
    display: block;
    width: 100%;
    max-height: 36rem;
    height: auto;
    object-fit: contain;
  }

  .service-planning {
    background: var(--surface, #edf7fa);
  }

  .service-planning__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
  }

  .service-planning p {
    max-width: 65ch;
    margin-bottom: 1.5rem;
  }

  .service-prompts {
    border-left: 1px solid var(--line, #cedfe5);
    padding-left: clamp(1.5rem, 4vw, 4rem);
  }

  .service-prompts h2 {
    margin-top: 0;
    font-size: 1.3rem;
  }

  .service-prompts ul {
    margin: 1.25rem 0 0;
    padding-left: 1.25rem;
  }

  .service-prompts li + li {
    margin-top: 0.75rem;
  }

  .service-section-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-bottom: 2rem;
  }

  .service-photos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 1.5rem;
    align-items: start;
  }

  .service-photos :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .service-photos figcaption {
    margin-top: 0.75rem;
    color: var(--muted, #52666f);
    font-size: 0.95rem;
  }

  .service-related {
    border-top: 1px solid var(--line, #cedfe5);
  }

  .service-related__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 2rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 47.99rem) {
    .service-hero,
    .service-planning__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .service-prompts {
      border-left: 0;
      border-top: 1px solid var(--line, #cedfe5);
      padding: 1.5rem 0 0;
    }
  }

  @media (max-width: 31.99rem) {
    .service-related__links {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
