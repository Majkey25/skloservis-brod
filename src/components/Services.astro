---
import { Picture } from 'astro:assets';
import { getAbout, getContact, getGallery, getServices, getSettings } from '../content';
import { pageUrl, type Language } from '../lib/urls';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const [settings, about, contact, services, gallery] = await Promise.all([
  getSettings(),
  getAbout(),
  getContact(),
  getServices(),
  getGallery(),
]);
const photo = gallery.find((item) => item.image.src.includes('staircase-glass-wall')) ?? gallery[0];
const url = (page: Parameters<typeof pageUrl>[0]) => pageUrl(page, lang, import.meta.env.BASE_URL);
const labels = {
  cs: {
    process: 'Jak probíhá zakázka',
    enquiry: 'Nezávazná poptávka',
    gallery: 'Prohlédnout realizace',
    steps: ['Návrh', 'Zaměření', 'Výroba', 'Montáž'],
  },
  en: {
    process: 'How your project takes shape',
    enquiry: 'Project enquiry',
    gallery: 'View our work',
    steps: ['Planning', 'Measuring', 'Manufacture', 'Installation'],
  },
}[lang];
const paragraphs = about[`body_${lang}`].trim().split(/\n\s*\n/);
---

<section class="section" aria-labelledby="services-title">
  <div class="wrap services-intro">
    <div>
      <h1 id="services-title">{settings[`services_title_${lang}`]}</h1>
      <p class="lead">{settings[`services_text_${lang}`]}</p>
      <div class="services-actions">
        <a class="button" href={url('contact')}>
          {labels.enquiry}
        </a>
        <a class="button button--secondary" href={url('gallery')}>
          {labels.gallery}
        </a>
      </div>
    </div>
    {photo && (
      <figure class="services-photo">
        <Picture
          src={photo.image}
          alt={photo[`alt_${lang}`]}
          formats={['avif', 'webp']}
          widths={[360, 600, 900, Math.min(1200, photo.image.width)].filter(
            (width, index, all) => width <= photo.image.width && all.indexOf(width) === index,
          )}
          sizes="(min-width: 70rem) 32rem, (min-width: 48rem) 42vw, 100vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    )}
  </div>
</section>

<section class="section services-process" aria-labelledby="services-process-title">
  <div class="wrap services-columns">
    <div>
      <h2 class="section-title" id="services-process-title">
        {labels.process}
      </h2>
      <ol class="services-steps">
        {labels.steps.map((step) => (
          <li>{step}</li>
        ))}
      </ol>
    </div>
    <div>
      <p class="lead">{settings[`process_${lang}`]}</p>
      <p>{contact[`enquiry_text_${lang}`]}</p>
      <a class="text-link" href={url('contact')}>
        {contact[`enquiry_title_${lang}`]}
      </a>
      <details class="services-about">
        <summary>{about[`title_${lang}`]}</summary>
        <p class="lead">{about[`lead_${lang}`]}</p>
        {paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </details>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="services-products-title">
  <div class="wrap services-columns">
    <div>
      <h2 class="section-title" id="services-products-title">
        {settings[`products_title_${lang}`]}
      </h2>
      <p class="muted">{settings[`products_text_${lang}`]}</p>
    </div>
    <ul class="services-product-links">
      {services.map((service) => (
        <li>
          <a class="text-link" href={url(service.slug)}>
            {service[`title_${lang}`]}
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .services-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }

  .services-intro h1 {
    margin: 0 0 1.5rem;
    font-size: clamp(2.4rem, 4.5vw, 4.2rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .services-intro .lead {
    max-width: 52ch;
  }

  .services-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .services-photo {
    min-width: 0;
    margin: 0;
  }

  .services-photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    max-height: 28rem;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .services-process {
    background: var(--surface, #edf7fa);
  }

  .services-steps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    counter-reset: step;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .services-steps li {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .services-steps li::before {
    counter-increment: step;
    content: counter(step);
    display: grid;
    flex: none;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--accent, #087fa0);
    border-radius: 50%;
    color: var(--accent, #087fa0);
    font-weight: 600;
  }

  .services-columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
  }

  .services-columns p {
    max-width: 65ch;
  }

  .services-columns > div > p:first-child {
    margin-top: 0;
  }

  .services-product-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .services-product-links li {
    border-bottom: 1px solid var(--line, #cedfe5);
  }

  .services-product-links a {
    display: block;
    padding: 0.75rem 0;
  }

  .services-about {
    margin-top: 1.25rem;
  }

  .services-about summary {
    width: fit-content;
    padding-block: 0.5rem;
    color: var(--accent);
    cursor: pointer;
  }

  .services-about p {
    margin-top: 1rem;
  }

  @media (max-width: 47.99rem) {
    .services-intro,
    .services-columns {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 29.99rem) {
    .services-product-links {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
