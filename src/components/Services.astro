---
import { Picture } from 'astro:assets';
import { getAbout, getContact, getGallery, getServices, getSettings } from '../content';
import { pageUrl, type Language } from '../lib/urls';
import Icon from './Icon.astro';
import ProductIcon from './ProductIcon.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const [settings, about, contact, services, gallery] = await Promise.all([
  getSettings(),
  getAbout(),
  getContact(),
  getServices(),
  getGallery(),
]);
const photo = gallery.find((item) => item.image.src.includes('staircase-glass-wall')) ?? gallery[0];
const url = (page: Parameters<typeof pageUrl>[0]) => pageUrl(page, lang, import.meta.env.BASE_URL);
const labels = {
  cs: {
    process: 'Jak probíhá zakázka',
    enquiry: 'Nezávazná poptávka',
    gallery: 'Prohlédnout realizace',
    groups: 'Co pro vás vyrobíme',
    offer: 'Zobrazit nabídku',
    steps: ['Návrh', 'Zaměření', 'Výroba', 'Montáž'],
  },
  en: {
    process: 'How your project takes shape',
    enquiry: 'Project enquiry',
    gallery: 'View our work',
    groups: 'What we make for you',
    offer: 'See the offer',
    steps: ['Planning', 'Measuring', 'Manufacture', 'Installation'],
  },
}[lang];
const paragraphs = about[`body_${lang}`].trim().split(/\n\s*\n/);
---

<section class="section" aria-labelledby="services-title">
  <div class="wrap services-intro">
    <div data-reveal="rise">
      <h1 id="services-title">{settings[`services_title_${lang}`]}</h1>
      <p class="lead">{settings[`services_text_${lang}`]}</p>
      <div class="services-actions">
        <a class="button" href={url('contact')}>
          {labels.enquiry}
        </a>
        <a class="button button--secondary" href={url('gallery')}>
          {labels.gallery}
        </a>
      </div>
    </div>
    {photo && (
      <figure class="services-photo">
        <Picture
          src={photo.image}
          alt={photo[`alt_${lang}`]}
          formats={['avif', 'webp']}
          widths={[360, 600, 900, Math.min(1200, photo.image.width)].filter(
            (width, index, all) => width <= photo.image.width && all.indexOf(width) === index,
          )}
          sizes="(min-width: 70rem) 32rem, (min-width: 48rem) 42vw, 100vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    )}
  </div>
</section>

<section class="section services-groups" aria-labelledby="services-groups-title">
  <div class="wrap">
    <h2 class="section-title" id="services-groups-title" data-reveal="rise">
      {labels.groups}
    </h2>
    <div class="services-groups__grid">
      {about.service_groups.map((group) => (
        <article class="services-group" data-reveal="rise">
          <h3>{group[`title_${lang}`]}</h3>
          <p class="services-group__summary">{group[`summary_${lang}`]}</p>
          <p>{group[`text_${lang}`]}</p>
          <a class="text-link services-group__link" href={url(group.link)}>
            {labels.offer} <Icon name="arrow-right" />
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap services-offers">
    <article data-reveal="rise">
      <h2>{about[`special_glass_title_${lang}`]}</h2>
      <p>{about[`special_glass_text_${lang}`]}</p>
    </article>
    <article data-reveal="rise">
      <h2>{about[`consultation_title_${lang}`]}</h2>
      <p>{about[`consultation_text_${lang}`]}</p>
    </article>
  </div>
</section>

<section class="section services-process" aria-labelledby="services-process-title">
  <div class="wrap services-columns">
    <div data-reveal="rise">
      <h2 class="section-title" id="services-process-title">
        {labels.process}
      </h2>
      <ol class="services-steps">
        {labels.steps.map((step) => (
          <li>{step}</li>
        ))}
      </ol>
    </div>
    <div data-reveal="rise">
      <p class="lead">{settings[`process_${lang}`]}</p>
      <p>{contact[`enquiry_text_${lang}`]}</p>
      <a class="text-link" href={url('contact')}>
        {contact[`enquiry_title_${lang}`]}
      </a>
      <details class="services-about">
        <summary>
          {about[`title_${lang}`]} <Icon name="chevron-down" />
        </summary>
        <p class="lead">{about[`lead_${lang}`]}</p>
        {paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </details>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="services-products-title">
  <div class="wrap services-columns">
    <div data-reveal="rise">
      <h2 class="section-title" id="services-products-title">
        {settings[`products_title_${lang}`]}
      </h2>
      <p class="muted">{settings[`products_text_${lang}`]}</p>
    </div>
    <ul class="services-product-links" data-reveal="rise">
      {services.map((service) => (
        <li>
          <a href={url(service.slug)}>
            <span class="services-product-links__glyph">
              <ProductIcon slug={service.slug} />
            </span>
            <span class="services-product-links__title">{service[`title_${lang}`]}</span>
            <Icon name="arrow-right" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .services-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }

  .services-intro h1 {
    margin: 0 0 1.5rem;
    font-size: clamp(2.4rem, 4.5vw, 4.2rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .services-intro .lead {
    max-width: 52ch;
  }

  .services-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .services-photo {
    min-width: 0;
    margin: 0;
  }

  .services-photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    max-height: 28rem;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .services-groups {
    background: var(--surface);
  }

  .services-groups__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem clamp(2rem, 4vw, 4rem);
  }

  .services-group {
    min-width: 0;
  }

  .services-group h3 {
    margin-bottom: 0.75rem;
    font-size: var(--step-2);
    line-height: 1.25;
  }

  .services-group__summary {
    margin-bottom: 0.75rem;
    font-weight: 600;
  }

  .services-group p {
    max-width: 65ch;
  }

  .services-group__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    margin-top: 0.5rem;
  }

  .services-offers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 4rem);
  }

  .services-offers h2 {
    margin-bottom: 0.75rem;
    font-size: var(--step-2);
    line-height: 1.25;
  }

  .services-offers p {
    max-width: 65ch;
    color: var(--muted);
  }

  .services-process {
    background: var(--surface);
  }

  .services-steps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    counter-reset: step;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .services-steps li {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .services-steps li::before {
    counter-increment: step;
    content: counter(step);
    display: grid;
    flex: none;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--accent, #087fa0);
    border-radius: 50%;
    color: var(--accent, #087fa0);
    font-weight: 600;
  }

  .services-columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
  }

  .services-columns p {
    max-width: 65ch;
  }

  .services-columns > div > p:first-child {
    margin-top: 0;
  }

  .services-product-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .services-product-links li {
    border-bottom: 1px solid var(--line, #cedfe5);
  }

  .services-product-links a {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-height: 3.75rem;
    padding: 0.6rem 0;
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease);
  }

  .services-product-links__title {
    flex: 1;
  }

  .services-product-links__glyph {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--line));
    border-radius: 50%;
    background: var(--glass-solid);
    color: var(--accent);
    transition:
      background-color var(--dur-bleed) var(--ease),
      color var(--dur-bleed) var(--ease);
  }

  .services-product-links a :global([data-icon='arrow-right']) {
    color: var(--accent);
  }

  .services-product-links a:hover,
  .services-product-links a:focus-visible {
    color: var(--accent);
  }

  .services-product-links a:hover .services-product-links__glyph,
  .services-product-links a:focus-visible .services-product-links__glyph {
    background: var(--accent);
    color: var(--on-accent);
  }

  .services-about {
    margin-top: 1.25rem;
  }

  .services-about summary {
    width: fit-content;
    padding-block: 0.5rem;
    color: var(--accent);
    cursor: pointer;
  }

  .services-about p {
    margin-top: 1rem;
  }

  @media (max-width: 47.99rem) {
    .services-intro,
    .services-columns,
    .services-groups__grid,
    .services-offers {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 29.99rem) {
    .services-product-links {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
