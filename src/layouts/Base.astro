---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import favicon from '../assets/brand/favicon.png';
import logo from '../assets/brand/wordpress-logo.png';
import { getSettings, getContact, getHours } from '../content.ts';
import type { Language, PageId } from '../lib/urls.ts';
import { seoContext, pageSeo, localBusiness, jsonLd } from '../lib/seo.ts';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Notices from '../components/Notices.astro';
interface Props {
  lang: Language;
  page: PageId;
  title?: string;
  description?: string;
}
const { lang, page, title, description } = Astro.props;
const settings = await getSettings();
const pageTitle = title ?? (lang === 'cs' ? settings.seo_title_cs : settings.seo_title_en);
const pageDescription =
  description ?? (lang === 'cs' ? settings.seo_description_cs : settings.seo_description_en);
const base = import.meta.env.BASE_URL;
const seo = seoContext(import.meta.env.SITE_BUILD_TARGET, Astro.site, base);
const metadata = pageSeo(seo, Astro.url.pathname, lang);
const business = metadata.business
  ? localBusiness(seo, settings, await getContact(), await getHours())
  : undefined;
---

<!doctype html>
<html lang={lang} data-language={lang} data-page={page} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="icon"
      type="image/png"
      sizes={`${favicon.width}x${favicon.height}`}
      href={favicon.src}
    />
    <link rel="icon" type="image/png" sizes={`${logo.width}x${logo.height}`} href={logo.src} />
    <link rel="apple-touch-icon" href={logo.src} />
    <ClientRouter fallback="swap" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content={metadata.robots} />
    {metadata.canonical && <link rel="canonical" href={metadata.canonical} />}
    {metadata.canonical && <meta property="og:url" content={metadata.canonical} />}
    {metadata.alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.lang} href={alternate.href} />
    ))}
    {business && <script type="application/ld+json" is:inline set:html={jsonLd(business)} />}
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'cs' ? 'cs_CZ' : 'en_GB'} />
    <meta property="og:site_name" content="Skloservis Brod" />
    <meta property="og:image" content={new URL(logo.src, Astro.site).href} />
    <meta property="og:image:width" content={String(logo.width)} />
    <meta property="og:image:height" content={String(logo.height)} />
    <meta property="og:image:alt" content="Skloservis Brod" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        try {
          const raw = localStorage.getItem('skloservis-theme');
          if (raw) {
            const saved = JSON.parse(raw);
            const now = Date.now();
            if (
              saved &&
              typeof saved.expires === 'number' &&
              Number.isFinite(saved.expires) &&
              saved.expires > now &&
              saved.expires <= now + 180 * 24 * 60 * 60 * 1000 &&
              (saved.value === 'dark' || saved.value === 'light')
            )
              theme = saved.value;
            else localStorage.removeItem('skloservis-theme');
          }
        } catch {}
        root.dataset.theme = theme;
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', theme === 'dark' ? '#071e28' : '#ffffff');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {lang === 'cs' ? 'Přeskočit na obsah' : 'Skip to content'}
    </a>
    <Header lang={lang} page={page} />
    <Notices lang={lang} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import '../scripts/preferences.ts';
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
