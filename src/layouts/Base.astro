---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import favicon from '../assets/brand/favicon.png';
import logo from '../assets/brand/wordpress-logo.png';
import { getSettings, getContact, getHours, getServices, getGallery } from '../content.ts';
import { pageUrl, type Language, type PageId } from '../lib/urls.ts';
import {
  seoContext,
  pageSeo,
  defaultDescription,
  localBusiness,
  serviceBreadcrumbs,
  socialPreview,
  website,
  SITE_NAME,
  jsonLd,
} from '../lib/seo.ts';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Notices from '../components/Notices.astro';
interface Props {
  lang: Language;
  page: PageId;
  title?: string;
  description?: string;
}
const { lang, page, title, description } = Astro.props;
const settings = await getSettings();
const pageTitle = title ?? (lang === 'cs' ? settings.seo_title_cs : settings.seo_title_en);
const base = import.meta.env.BASE_URL;
const seo = seoContext(import.meta.env.SITE_BUILD_TARGET, Astro.site, base);
const metadata = pageSeo(seo, Astro.url.pathname, lang);
const pageDescription =
  description ??
  defaultDescription(seo, Astro.url.pathname, lang, settings[`seo_description_${lang}`]);
const business = metadata.business
  ? localBusiness(seo, settings, await getContact(), await getHours())
  : undefined;
const siteName = metadata.website ? website(seo) : undefined;
const [services, gallery] = await Promise.all([getServices(), getGallery()]);
const breadcrumbs = serviceBreadcrumbs(
  seo,
  Astro.url.pathname,
  lang,
  services.find((service) => service.slug === page),
);
const socialImage = socialPreview(seo, Astro.url.pathname, lang, gallery);
---

<!doctype html>
<html
  lang={lang}
  data-language={lang}
  data-page={page}
  data-home-en={pageUrl('home', 'en', base)}
  data-build-target={seo.target}
>
  <head>
    <meta charset="utf-8" />
    <meta
      http-equiv="Content-Security-Policy"
      content="base-uri 'none'; object-src 'none'; script-src-attr 'none'; connect-src 'self' https://formsubmit.co; form-action https://formsubmit.co; frame-src https://www.google.com/maps/embed; img-src 'self'; font-src 'self'; media-src 'self'; manifest-src 'self'; worker-src 'none'"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        // First full load only: hold the entrance until the page has painted; motion.ts plays it.
        // The timer guarantees the content appears even if the module script never runs.
        if (
          document.readyState === 'loading' &&
          !matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          root.dataset.entry = 'pending';
          setTimeout(() => {
            if (root.dataset.entry === 'pending') root.dataset.entry = 'play';
          }, 2500);
        }
        const readPreference = (key, values) => {
          try {
            const raw = localStorage.getItem(key);
            if (!raw) return;
            const saved = JSON.parse(raw);
            const now = Date.now();
            if (
              saved &&
              typeof saved.expires === 'number' &&
              Number.isFinite(saved.expires) &&
              saved.expires > now &&
              saved.expires <= now + 180 * 24 * 60 * 60 * 1000 &&
              values.includes(saved.value)
            )
              return saved.value;
            localStorage.removeItem(key);
          } catch {
            try {
              localStorage.removeItem(key);
            } catch {}
          }
        };
        const theme =
          readPreference('skloservis-theme', ['dark', 'light']) ??
          (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const savedLanguage = readPreference('skloservis-language', ['cs', 'en']);
        root.dataset.theme = theme;
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', theme === 'dark' ? '#071e28' : '#ffffff');

        // Select an initial homepage before loading the app, never during a client-side swap.
        // Production language URLs stay explicit, regardless of device or saved preferences.
        if (
          root.dataset.buildTarget !== 'preview' ||
          document.readyState !== 'loading' ||
          root.dataset.page !== 'home' ||
          root.dataset.language !== 'cs' ||
          location.search ||
          location.hash ||
          performance.getEntriesByType('navigation')[0]?.type === 'back_forward' ||
          (document.referrer && new URL(document.referrer).origin === location.origin)
        )
          return;
        const locale = navigator.languages?.[0] || navigator.language;
        const language =
          savedLanguage ??
          (locale ? (locale.toLowerCase().split('-')[0] === 'cs' ? 'cs' : 'en') : undefined);
        if (language !== 'en' || !root.dataset.homeEn) return;
        const target = new URL(root.dataset.homeEn, location.href);
        const currentPath = location.pathname.endsWith('/')
          ? location.pathname
          : `${location.pathname}/`;
        if (target.origin === location.origin && target.pathname === `${currentPath}en/`)
          location.replace(target.href);
      })();
    </script>
    <link
      rel="icon"
      type="image/png"
      sizes={`${favicon.width}x${favicon.height}`}
      href={favicon.src}
    />
    <link rel="icon" type="image/png" sizes={`${logo.width}x${logo.height}`} href={logo.src} />
    <link rel="apple-touch-icon" href={logo.src} />
    <ClientRouter fallback="swap" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content={metadata.robots} />
    {metadata.canonical && <link rel="canonical" href={metadata.canonical} />}
    {metadata.canonical && <meta property="og:url" content={metadata.canonical} />}
    {metadata.alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.lang} href={alternate.href} />
    ))}
    {siteName && <script type="application/ld+json" is:inline set:html={jsonLd(siteName)} />}
    {business && <script type="application/ld+json" is:inline set:html={jsonLd(business)} />}
    {breadcrumbs && <script type="application/ld+json" is:inline set:html={jsonLd(breadcrumbs)} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'cs' ? 'cs_CZ' : 'en_GB'} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={socialImage.src} />
    <meta property="og:image:secure_url" content={socialImage.src} />
    <meta property="og:image:type" content={socialImage.type} />
    <meta property="og:image:width" content={String(socialImage.width)} />
    <meta property="og:image:height" content={String(socialImage.height)} />
    <meta property="og:image:alt" content={socialImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImage.src} />
    <meta name="twitter:image:alt" content={socialImage.alt} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {lang === 'cs' ? 'Přeskočit na obsah' : 'Skip to content'}
    </a>
    <Header lang={lang} page={page} />
    <Notices lang={lang} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import '../scripts/preferences.ts';
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
