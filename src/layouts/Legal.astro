---
import Base from './Base.astro';
import { ROUTES, type Language } from '../lib/urls.ts';

interface Props {
  frontmatter: { title: string; lang: Language; alternate: string };
}
const { title, lang, alternate } = Astro.props.frontmatter;
const page = ROUTES.find((route) => route[lang === 'cs' ? 'en' : 'cs'] === alternate)?.id;
if (!page) throw new Error(`Unknown legal page counterpart: ${alternate}`);
---

<Base lang={lang} page={page} title={`${title} | Skloservis Brod`}>
  <article class="wrap section prose">
    <h1>{title}</h1>
    <slot />
  </article>
</Base>
