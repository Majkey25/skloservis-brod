---
import { pageUrl, type Language } from '../lib/urls.ts';

interface Props {
  frontmatter: { title: string; lang: Language; alternate: string };
}
const { title, lang, alternate } = Astro.props.frontmatter;
const base = import.meta.env.BASE_URL;
const local = (path: string) => `${base.replace(/\/?$/, '/')}${path.replace(/^\//, '')}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <title>{title} | Skloservis Brod</title>
  </head>
  <body>
    <header>
      <a href={pageUrl('home', lang, base)}>Skloservis Brod</a>
      <a href={local(alternate)} lang={lang === 'cs' ? 'en' : 'cs'}>
        {lang === 'cs' ? 'English' : 'Česky'}
      </a>
    </header>
    <main>
      <h1>{title}</h1>
      <slot />
    </main>
    <footer>
      <p>SKLOSERVIS-BROD s.r.o. · IČO 02596491</p>
      <nav aria-label={lang === 'cs' ? 'Právní informace' : 'Legal information'}>
        <a href={pageUrl('privacy', lang, base)}>{lang === 'cs' ? 'Soukromí' : 'Privacy'}</a>
        <a href={pageUrl('cookies', lang, base)}>
          {lang === 'cs' ? 'Cookies a úložiště' : 'Cookies and storage'}
        </a>
        <a href={pageUrl('legal', lang, base)}>
          {lang === 'cs' ? 'Provozovatel a spotřebitelé' : 'Company and consumers'}
        </a>
      </nav>
    </footer>
  </body>
</html>
