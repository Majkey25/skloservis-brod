---
import type { GetStaticPaths } from 'astro';
import Base from '../layouts/Base.astro';
import ServiceDetail from '../components/ServiceDetail.astro';
import { ROUTES, SERVICE_ROUTES, type Language, type ServiceSlug } from '../lib/urls.ts';
export const getStaticPaths = (() =>
  ROUTES.filter((route) => route.id in SERVICE_ROUTES).flatMap((route) =>
    (['cs', 'en'] as const).map((lang) => ({
      params: { path: route[lang].replace(/^\//, '').replace(/\/$/, '') },
      props: { lang, page: route.id },
    })),
  )) satisfies GetStaticPaths;
interface Props {
  lang: Language;
  page: ServiceSlug;
}
const { lang, page } = Astro.props;
---

<Base lang={lang} page={page}>
  <ServiceDetail lang={lang} slug={page} />
</Base>
