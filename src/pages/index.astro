---
import { pageUrl } from '../lib/urls.ts';
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <title>Skloservis Brod | Příprava webu</title>
  </head>
  <body>
    <main>
      <h1>Skloservis Brod</h1>
      <p>Technický základ nového webu. Návrh stránek zatím není hotový.</p>
      <a href="https://www.skloservis-brod.cz/">Současný web Skloservis Brod</a>
    </main>
    <footer>
      <p>SKLOSERVIS-BROD s.r.o. · IČO 02596491</p>
      <nav aria-label="Právní informace">
        <a href={pageUrl('privacy', 'cs', base)}>Soukromí</a>
        <a href={pageUrl('cookies', 'cs', base)}>Cookies a úložiště</a>
        <a href={pageUrl('legal', 'cs', base)}>Provozovatel a spotřebitelé</a>
      </nav>
    </footer>
  </body>
</html>
